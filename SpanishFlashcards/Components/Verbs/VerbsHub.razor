@* The Verbs tab: tense → type → group → verb. Every item has Overview, Rules and Practice, and a progress bar. *@
@inject VerbRepository VerbRepo

@if (book is null || tree is null)
{
    <div class="list-screen"><div class="empty">@(loadError ?? "Loading verbs…")</div></div>
}
else
{
    var now = DateTime.UtcNow;
    var node = Current;
    var stats = VerbTree.Stats(node, Progress.VerbSkills, now);
    var round = RoundFor(node);
    var resume = ResumeRound;
    var mastered = VerbTests.IsMastered(node, Progress.VerbSkills, Progress.VerbTests);

    <div class="verbs">
        @if (resume is not null && !(view == (resume.IsTest ? View.Test : View.Practice) && resume.Node == node))
        {
            <div class="vb-resume" role="status">
                <span class="vb-resume-text">
                    <span class="vb-resume-label">@(resume.IsTest ? "Test in progress" : "Practice in progress")</span>
                    <span>@($"{resume.Node.Title} · {resume.PositionText}")</span>
                </span>
                <button type="button" class="primary vb-resume-btn" @onclick="() => Resume(resume)">Resume</button>
                <button type="button" class="vb-resume-x" aria-label="@(resume.IsTest ? "Discard this test" : "Discard this practice")"
                        title="Discard" @onclick="() => Discard(resume)">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
                </button>
            </div>
        }
        <div class="segmented vb-mode" role="tablist" aria-label="Show verbs as">
            <button type="button" role="tab" class="seg @(mode == Mode.Tree ? "on" : "")" aria-selected="@(mode == Mode.Tree ? "true" : "false")" @onclick="() => mode = Mode.Tree">Tree</button>
            <button type="button" role="tab" class="seg @(mode == Mode.Grid ? "on" : "")" aria-selected="@(mode == Mode.Grid ? "true" : "false")" @onclick="() => mode = Mode.Grid">Grid</button>
            <button type="button" role="tab" class="seg @(mode == Mode.Decode ? "on" : "")" aria-selected="@(mode == Mode.Decode ? "true" : "false")" @onclick="() => mode = Mode.Decode">Decode</button>
        </div>

        @if (mode == Mode.Decode)
        {
            <DecodeView Book="book" Progress="Progress" OnSaved="Saved" CanSpeak="CanSpeak" Speak="Speak" Tree="tree" OnOpenRules="OpenRulesFromDecode" />
        }
        else if (mode == Mode.Grid)
        {
            <GridView Tree="tree" Book="book" Progress="Progress" OnOpen="OpenFromGrid" OnPractise="PractiseFromGrid" />
        }
        else
        {
        <div class="vb-head">
            @if (node.Parent is not null)
            {
                <nav class="vb-crumbs" aria-label="Where you are">
                    <button type="button" class="tool back-btn" @onclick="() => Go(node.Parent)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
                        @node.Parent.Title
                    </button>
                    @if (node.Ancestors().Count() > 1)
                    {
                        <span class="vb-trail">@(string.Join(" › ", node.Ancestors().Reverse().Skip(1).Select(a => a.Title)))</span>
                    }
                </nav>
            }
            <div class="vb-title-row">
                <h2 class="vb-title" lang="@(node.Kind == NodeKind.Verb ? "es" : "en")">
                    @node.Title
                    @if (mastered)
                    {
                        <span class="badge mastered">Mastered</span>
                    }
                </h2>
                <span class="vb-pct">@stats.Percent%</span>
            </div>
            @if (!string.IsNullOrEmpty(node.Subtitle))
            {
                <div class="vb-sub">@node.Subtitle</div>
            }
            <div class="progress vb-bar" role="progressbar" aria-label="@($"{node.Title}: strength")"
                 aria-valuemin="0" aria-valuemax="100" aria-valuenow="@stats.Percent">
                <div class="progress-fill" style="width: @(stats.Percent)%"></div>
            </div>
            <div class="vb-counts">
                @($"{stats.Started} of {stats.Total} forms practised · {stats.Strong} strong · {stats.Due} due now")
            </div>

            <div class="segmented vb-views" role="tablist" aria-label="View">
                <button type="button" role="tab" class="seg @(view == View.Overview ? "on" : "")" aria-selected="@(view == View.Overview ? "true" : "false")" @onclick="() => SetView(View.Overview)">Overview</button>
                <button type="button" role="tab" class="seg @(view == View.Rules ? "on" : "")" aria-selected="@(view == View.Rules ? "true" : "false")" @onclick="() => SetView(View.Rules)">Rules</button>
                <button type="button" role="tab" class="seg @(view == View.Practice ? "on" : "")" aria-selected="@(view == View.Practice ? "true" : "false")" @onclick="OpenPractice">Practice@(round?.InProgress == true ? Dot : null)</button>
                @if (VerbTests.CanTest(node))
                {
                    var test = TestFor(node);
                    @if (node.Kind == NodeKind.Tense && book.StoryFor(node.Tense!) is not null)
                    {
                        <button type="button" role="tab" class="seg @(view == View.Story ? "on" : "")" aria-selected="@(view == View.Story ? "true" : "false")" @onclick="() => SetView(View.Story)">Story</button>
                    }
                    <button type="button" role="tab" class="seg @(view == View.Test ? "on" : "")" aria-selected="@(view == View.Test ? "true" : "false")" @onclick="() => SetView(View.Test)">Test@(test?.InProgress == true ? Dot : null)</button>
                }
            </div>
        </div>

        <div class="vb-body">
            @if (view == View.Rules)
            {
                <VerbRulesView @key="node.Id" Page="RulesFor(node)" Book="book" />
            }
            else if (view == View.Story && node.Tense is not null && book.StoryFor(node.Tense) is { } story)
            {
                <StoryView @key="node.Id" Story="story" Book="book" Tree="tree" CanSpeak="CanSpeak" Speak="Speak" OnOpen="Go" />
            }
            else if (view == View.Test)
            {
                <VerbTest @key="node.Id" Node="node" Book="book" Progress="Progress" Round="TestFor(node)"
                          OnStart="StartTest" OnSaved="Saved" OnClose="() => SetView(View.Overview)" OnPractise="PractiseNode" />
            }
            else if (view == View.Practice)
            {
                @if (round is not null)
                {
                    <VerbPractice @key="round" R="round" OnSaved="Saved"
                                  OnClose="() => SetView(View.Overview)" CanSpeak="CanSpeak" Speak="Speak" />
                }
            }
            else
            {
                @if (node.Kind == NodeKind.Root && UpNextFor(now) is { } next)
                {
                    <section class="vb-next" aria-label="Up next">
                        <div class="vb-next-kicker">Up next</div>
                        <div class="vb-next-title">@next.Title</div>
                        <div class="vb-next-text">@next.Text</div>
                        <div class="vb-next-actions">
                            <button type="button" class="primary vb-next-go" @onclick="() => GoUpNext(next)">@next.Button</button>
                            @if (next.ShowRules)
                            {
                                <button type="button" class="tool vb-next-rules" @onclick="() => OpenRulesFromDecode(next.Node)">Read the rules first</button>
                            }
                        </div>
                    </section>
                }

                @if (node.Kind is NodeKind.Root or NodeKind.Tense or NodeKind.Type)
                {
                    var weak = VerbTests.WeakSpots(node, Progress.VerbSkills, Progress.VerbTests);
                    @if (weak.Count > 0)
                    {
                        <section class="vb-weak @(weakOpen ? "open" : "")" aria-label="Weak spots">
                            <button type="button" class="vb-weak-head" aria-expanded="@(weakOpen ? "true" : "false")" @onclick="() => weakOpen = !weakOpen">
                                <span class="vb-weak-heading">@($"Weak spots ({weak.Count})")</span>
                                <span class="vb-weak-chevron" aria-hidden="true"></span>
                            </button>
                            @if (weakOpen)
                            {
                            @foreach (var w in weak)
                            {
                                var wn = w.Node;
                                <div class="vb-weak-row">
                                    <button type="button" class="vb-weak-text" @onclick="() => Go(wn)">
                                        <span class="vb-weak-title">@wn.Title</span>
                                        @if (w.Path.Length > 0)
                                        {
                                            <span class="vb-weak-path">@w.Path</span>
                                        }
                                        <span class="vb-weak-reason">@w.Reason</span>
                                    </button>
                                    <button type="button" class="tool small" @onclick="() => PractiseNode(wn)">Practise</button>
                                </div>
                            }
                            }
                        </section>
                    }
                }

                @if (node.Kind == NodeKind.Root)
                {
                    @foreach (var stage in VerbGrammar.Stages)
                    {
                        var st = stage;
                        var kids = node.Children.Where(c => c.TenseInfo?.Stage == st.Number).ToList();
                        var open = StageOpen(st.Number, kids, now);
                        <section class="vb-stage @(open ? "open" : "")" aria-label="@st.Title">
                            <button type="button" class="vb-stage-head" aria-expanded="@(open ? "true" : "false")" @onclick="() => stageOpen[st.Number] = !open">
                                <span class="vb-stage-num" aria-hidden="true">@st.Number</span>
                                <span class="vb-stage-text">
                                    <span class="vb-stage-title">@st.Title</span>
                                    <span class="vb-stage-blurb">@st.Blurb</span>
                                </span>
                                <span class="vb-weak-chevron" aria-hidden="true"></span>
                            </button>
                            @if (open)
                            {
                                <div class="list vb-list">
                                    @foreach (var child in kids)
                                    {
                                        @RowFor(child, VerbTree.Stats(child, Progress.VerbSkills, now))
                                    }
                                </div>
                                @if (st.Number == 4)
                                {
                                    <button type="button" class="tool vb-stage-decode" @onclick="() => FocusDecode(kids.Select(k => k.Tense!))">Practise reading these in Decode</button>
                                }
                            }
                        </section>
                    }
                }
                else if (node.Children.Count > 0)
                {
                    <div class="list vb-list">
                        @foreach (var child in node.Children)
                        {
                            @RowFor(child, VerbTree.Stats(child, Progress.VerbSkills, now))
                        }
                    </div>
                }
                else if (node.Kind == NodeKind.Verb && node.Verb is not null)
                {
                    <ConjugationTable Verb="node.Verb" Tense="@(node.Tense!)" Highlight="@(node.Forms.Select(f => f.Person).ToHashSet())" />
                    <p class="list-hint">Highlighted forms are practised and tracked here.</p>
                }
                else if (node.Pattern is not null && node.Members.Count > 0)
                {
                    <EndingsTable Tense="@(node.Tense!)" Sample="node.Members[0]" />
                    <p class="list-hint">@($"You practise these endings with a different regular verb each time: {string.Join(", ", node.Members.Take(8).Select(v => v.Inf))}{(node.Members.Count > 8 ? $" and {node.Members.Count - 8} more" : "")}.")</p>
                }

                var byPerson = VerbTree.MistakesByPerson(node, Progress.VerbSkills);
                @if (byPerson.Any(x => x.Mistakes > 0))
                {
                    var max = byPerson.Max(x => x.Mistakes);
                    <section class="vb-persons @(personsOpen ? "open" : "")" aria-label="Mistakes by person">
                        <button type="button" class="vb-weak-head" aria-expanded="@(personsOpen ? "true" : "false")" @onclick="() => personsOpen = !personsOpen">
                            <span class="vb-persons-heading">Mistakes by person</span>
                            <span class="vb-weak-chevron" aria-hidden="true"></span>
                        </button>
                        @if (personsOpen)
                        {
                            @foreach (var (label, m) in byPerson)
                            {
                                <div class="vb-person">
                                    <span class="vb-person-label">@label</span>
                                    <span class="vb-person-bar"><span style="width: @(max > 0 ? (int)Math.Round(m * 100 / max) : 0)%"></span></span>
                                    <span class="vb-person-n">@(m % 1 == 0 ? m.ToString("0") : m.ToString("0.0"))</span>
                                </div>
                            }
                            <p class="small">A missing accent counts as half a mistake.</p>
                        }
                    </section>
                }

                @if (node.Kind != NodeKind.Root)
                {
                    @* The top page has Up next instead: practising all 3,000 forms at once isn't a useful start. *@
                    var readOnly = node.TenseInfo is { Stage: 4 };
                    @if (readOnly)
                    {
                        <button type="button" class="primary wide vb-practise" @onclick="() => FocusDecode(new[] { node.Tense! })">Practise reading (Decode)</button>
                        <p class="list-hint">Rare in conversation: being able to recognise it is enough. You can still practise making the forms.</p>
                    }
                    <button type="button" class="@(readOnly ? "tool vb-test-btn" : "primary wide vb-practise")" @onclick="OpenPractice">
                        @(round?.InProgress == true ? $"Continue practice ({round.PositionText})"
                          : stats.Due > 0 ? $"Practise ({stats.Due} due)" : readOnly ? "Practise making the forms" : "Practise")
                    </button>
                    @if (VerbTests.CanTest(node))
                    {
                        <button type="button" class="tool vb-test-btn" @onclick="() => SetView(View.Test)">
                            @(TestFor(node)?.InProgress == true ? "Continue the test" : "Test yourself")
                        </button>
                    }
                }
            }
        </div>
        }
    </div>
}

@code {
    private enum View { Overview, Rules, Practice, Test, Story }

    [Parameter, EditorRequired] public Progress Progress { get; set; } = default!;
    [Parameter] public EventCallback OnProgressChanged { get; set; }
    [Parameter] public bool CanSpeak { get; set; }
    [Parameter] public Func<string, Task>? Speak { get; set; }

    // Where you were in the tree, kept while the app is open (switching tabs doesn't lose your place).
    private static string? lastNodeId;
    private static View lastView = View.Overview;

    /// <summary>Open a tense next time the Verbs tab shows (from the Read tab): its Rules, or its Overview.</summary>
    public static void ShowTense(string tense, bool rules)
    {
        lastNodeId = $"t:{tense}";
        lastView = rules ? View.Rules : View.Overview;
        mode = Mode.Tree;
    }

    /// <summary>Show Decode next time the Verbs tab shows (set its tenses with DecodeView.Focus first).</summary>
    public static void ShowDecode() => mode = Mode.Decode;

    private VerbBook? book;
    private VerbNode? tree;
    private VerbNode? current;
    private View view = View.Overview;
    private string? loadError;

    private VerbNode Current => current ?? tree!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            (book, tree) = await VerbRepo.GetAsync();
            current = lastNodeId is null ? tree : VerbTree.Find(tree, lastNodeId) ?? tree;
            view = lastView;
            if (view == View.Practice && RoundFor(Current) is null) view = View.Overview;
            if (view == View.Test && !VerbTests.CanTest(Current)) view = View.Overview;
            if (view == View.Story && (Current.Kind != NodeKind.Tense || book.StoryFor(Current.Tense!) is null)) view = View.Overview;
        }
        catch (Exception ex)
        {
            loadError = $"Couldn't load the verbs: {ex.Message}";
        }
    }

    private void Go(VerbNode? node)
    {
        if (node is null) return;
        current = node;
        lastNodeId = node.Id;
        SetView(View.Overview);
    }

    private void SetView(View v)
    {
        view = v;
        lastView = v;
    }

    private Task Saved() => OnProgressChanged.InvokeAsync();

    // Practice rounds, one per item, kept while the app is open: switching to Rules or Overview, opening
    // another item or another app tab doesn't lose your place (or a half-spelled answer).
    private static readonly Dictionary<string, PracticeRound> rounds = new();

    private static PracticeRound? RoundFor(VerbNode node) => rounds.GetValueOrDefault(node.Id);

    // Tests, one per item: the one in progress, or the last one taken (its results stay on screen).
    private static readonly Dictionary<string, TestRound> tests = new();

    private static TestRound? TestFor(VerbNode node) => tests.GetValueOrDefault(node.Id);

    /// <summary>The most recently used unfinished round or test, for the Resume bar.</summary>
    private static IVerbRound? ResumeRound =>
        rounds.Values.Cast<IVerbRound>().Concat(tests.Values)
            .Where(r => r.InProgress).OrderByDescending(r => r.LastActive).FirstOrDefault();

    private void StartTest()
    {
        tests[Current.Id] = new TestRound(Current, book!, Progress);
        SetView(View.Test);
    }

    /// <summary>Open an item and start practising it (from Weak spots or test results).</summary>
    private void PractiseNode(VerbNode node)
    {
        current = node;
        lastNodeId = node.Id;
        OpenPractice();
    }

    /// <summary>Practice on this item: carry on with its unfinished round, or start a new one.</summary>
    private void OpenPractice()
    {
        var node = Current;
        if (RoundFor(node) is not { InProgress: true })
            rounds[node.Id] = new PracticeRound(node, book!, Progress);
        SetView(View.Practice);
    }

    // Weak spots open or folded, kept while the app is open.
    private static bool weakOpen = true;

    // Mistakes by person: folded unless you open it.
    private static bool personsOpen;

    // Stages on the top page: opened or folded by you (otherwise see StageOpen).
    private static readonly Dictionary<int, bool> stageOpen = new();

    /// <summary>The first two stages start open; later ones only once you've started something in them.</summary>
    private bool StageOpen(int stage, IEnumerable<VerbNode> tenses, DateTime now) =>
        stageOpen.TryGetValue(stage, out var open) ? open
            : stage <= 2 || tenses.Any(t => VerbTree.Stats(t, Progress.VerbSkills, now).Started > 0);

    /// <summary>One row of a list: title, how common (tenses), badges, and progress (or "Not started").</summary>
    private RenderFragment RowFor(VerbNode c, NodeStats cs) =>
        @<button type="button" class="row vb-row" @onclick="() => Go(c)">
            <span class="row-text">
                <span class="row-top">
                    <span class="row-word" lang="@(c.Kind == NodeKind.Verb ? "es" : "en")">@c.Title</span>
                    @if (c.Kind == NodeKind.Tense && c.TenseInfo is { } ti)
                    {
                        <span class="vb-freq" title="@ti.FrequencyLabel">
                            <span class="sr-only">@ti.FrequencyLabel</span>
                            @for (var i = 1; i <= 4; i++)
                            {
                                <span class="vb-freq-dot @(i <= ti.Frequency ? "on" : "")" aria-hidden="true"></span>
                            }
                        </span>
                    }
                    @if (VerbTests.IsMastered(c, Progress.VerbSkills, Progress.VerbTests))
                    {
                        <span class="badge mastered">Mastered</span>
                    }
                    @if (cs.Due > 0)
                    {
                        <span class="badge learning">@cs.Due due</span>
                    }
                </span>
                @if (!string.IsNullOrEmpty(c.Subtitle))
                {
                    <span class="row-sub" lang="@(c.Kind == NodeKind.Type || c.Kind == NodeKind.Tense ? "en" : "es")">@c.Subtitle</span>
                }
                @if (cs.Started > 0)
                {
                    <span class="vb-mini" aria-hidden="true"><span style="width: @(cs.Percent)%"></span></span>
                }
            </span>
            @if (cs.Started > 0)
            {
                <span class="vb-row-pct">@cs.Percent%</span>
            }
            else
            {
                <span class="vb-row-new">Not started</span>
            }
        </button>;

    // ------------------------------------------------------------------ up next

    /// <summary>The suggestion at the top of the Verbs page.</summary>
    private sealed record UpNext(VerbNode Node, string Title, string Text, string Button, bool ShowRules, bool Decode);

    /// <summary>
    /// Reviews first (the tense with the most forms due); otherwise the first tense in the learning order
    /// (stages 1 to 3) you haven't started or aren't ready to leave yet; once those are done, the rare
    /// tenses in Decode.
    /// </summary>
    private UpNext UpNextFor(DateTime now)
    {
        var tenses = tree!.Children;
        var stats = tenses.ToDictionary(t => t.Id, t => VerbTree.Stats(t, Progress.VerbSkills, now));

        VerbNode? learn = null;
        foreach (var t in tenses.Where(t => t.TenseInfo!.Stage <= 3))
        {
            if (stats[t.Id].Started == 0 || !ReadyToMoveOn(t, stats[t.Id], now)) { learn = t; break; }
        }

        var due = tenses.Where(t => stats[t.Id].Due > 0).OrderByDescending(t => stats[t.Id].Due).FirstOrDefault();
        if (due is not null)
        {
            var n = stats[due.Id].Due;
            var then = learn is null || learn == due ? "" : $" Then: {learn.Title}.";
            return new(due, $"Review: {due.Title}", $"{n} {(n == 1 ? "form is" : "forms are")} due. A short round keeps them fresh.{then}",
                $"Practise ({n} due)", false, false);
        }

        if (learn is not null)
        {
            var s = stats[learn.Id];
            var info = learn.TenseInfo!;
            return s.Started == 0
                ? new(learn, $"Start: {learn.Title}", $"{learn.Subtitle}. {info.FrequencyLabel} in conversation.", "Start practising", true, false)
                : new(learn, $"Keep going: {learn.Title}", $"{s.Percent}% so far. When the regular forms are solid, the next tense shows up here.", "Practise", false, false);
        }

        return new(tree!, "Recognise the rare tenses", "You've covered the main tenses. The last four are rare: practise reading them in Decode.",
            "Practise reading", false, true);
    }

    /// <summary>
    /// Good enough to move on: the regular endings are solid (60% or more) and the tense as a whole is at
    /// 20%, or you've mastered it with a test.
    /// </summary>
    private bool ReadyToMoveOn(VerbNode tense, NodeStats s, DateTime now)
    {
        if (VerbTests.IsMastered(tense, Progress.VerbSkills, Progress.VerbTests)) return true;
        var regular = tense.Children.Where(c => c.TypeId == "reg")
            .Select(c => VerbTree.Stats(c, Progress.VerbSkills, now)).ToList();
        return regular.All(r => r.Percent >= 60) && s.Percent >= 20;
    }

    private async Task GoUpNext(UpNext next)
    {
        if (next.Decode)
            await FocusDecode(VerbGrammar.Tenses.Where(t => t.Stage == 4).Select(t => t.Id));
        else
            PractiseNode(next.Node);
    }

    /// <summary>Switch to Decode, set up for these tenses.</summary>
    private async Task FocusDecode(IEnumerable<string> tenses)
    {
        DecodeView.Focus(Progress, tenses);
        mode = Mode.Decode;
        await Saved();
    }

    // Tree, grid or decode view of the Verbs tab, kept while the app is open.
    private enum Mode { Tree, Grid, Decode }

    private static Mode mode = Mode.Tree;

    private void OpenFromGrid(VerbNode node)
    {
        mode = Mode.Tree;
        Go(node);
    }

    /// <summary>From a Decode answer: show the rules for that verb or tense. The Decode round stays where it was.</summary>
    private void OpenRulesFromDecode(VerbNode node)
    {
        mode = Mode.Tree;
        current = node;
        lastNodeId = node.Id;
        SetView(View.Rules);
    }

    private void PractiseFromGrid(VerbNode node)
    {
        mode = Mode.Tree;
        PractiseNode(node);
    }

    /// <summary>The small dot on the Practice or Test tab while one is under way.</summary>
    private static readonly RenderFragment Dot = @<span class="vb-dot" title="In progress"><span class="sr-only"> (in progress)</span></span>;

    /// <summary>Throw away an unfinished practice round or test (answers already given still count).</summary>
    private void Discard(IVerbRound round)
    {
        foreach (var key in rounds.Where(kv => ReferenceEquals(kv.Value, round)).Select(kv => kv.Key).ToList()) rounds.Remove(key);
        foreach (var key in tests.Where(kv => ReferenceEquals(kv.Value, round)).Select(kv => kv.Key).ToList()) tests.Remove(key);
        if (current == round.Node && view == (round.IsTest ? View.Test : View.Practice)) SetView(View.Overview);
    }

    private void Resume(IVerbRound round)
    {
        mode = Mode.Tree;
        current = round.Node;
        lastNodeId = round.Node.Id;
        SetView(round.IsTest ? View.Test : View.Practice);
    }

    // The Rules page is built once per item, so its quick check keeps its answer while you read.
    private RulePage? rulesPage;
    private string? rulesFor;

    private RulePage RulesFor(VerbNode node)
    {
        if (rulesPage is null || rulesFor != node.Id)
        {
            rulesPage = VerbRules.For(node, book!);
            rulesFor = node.Id;
        }
        return rulesPage;
    }
}
