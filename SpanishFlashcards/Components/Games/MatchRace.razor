@* Match race: tap a Spanish word and its English meaning. 60 seconds; each wrong pair costs 3 seconds.
   Like Duolingo: a matched pair leaves an empty spot for a moment, then new words fill the same spots –
   nothing else moves. One unmatched word waits on each side, so the two tiles that appear together
   never belong to each other (no free answers from position or timing). *@
@implements IDisposable

@if (phase == Phase.Ready)
{
    <div class="race-intro">
        <div class="race-title">Match race</div>
        <p>Tap a Spanish word, then its English meaning. Matched spots refill after a moment.
           You have <strong>60 seconds</strong>, and every wrong pair costs <strong>3 seconds</strong>.</p>
        <p class="small">Best score: @Best</p>
        <button type="button" class="primary" @onclick="Start">Start</button>
    </div>
}
else if (phase == Phase.Playing)
{
    <div class="race">
        <div class="race-top">
            <div class="race-score" aria-live="polite">@score matched</div>
            <div class="race-time">@Math.Ceiling(clock.Remaining)s</div>
        </div>
        <div class="race-bar" aria-hidden="true">
            <div class="race-bar-fill @(clock.Remaining < 10 ? "low" : "")" style="width: @(clock.Percent)%"></div>
        </div>

        <div class="race-grid">
            @for (var r = 0; r < Rows; r++)
            {
                var i = r;
                var l = left[i];
                var rr = right[i];
                <button type="button" class="race-tile es @TileClass(true, i, l is null)"
                        aria-pressed="@(selLeft == i ? "true" : "false")"
                        disabled="@(l is null)" @onclick="() => TapLeft(i)">@(l?.Es)</button>
                <button type="button" class="race-tile en @TileClass(false, i, rr is null)"
                        aria-pressed="@(selRight == i ? "true" : "false")"
                        disabled="@(rr is null)" @onclick="() => TapRight(i)">@(rr?.En)</button>
            }
        </div>
    </div>
}
else
{
    <GameResults Headline="@($"{score} matched")" Score="score" PreviousBest="previousBest" Best="Best"
                 Mistakes="mistakes" OnPlayAgain="Start" />
}

@code {
    private enum Phase { Ready, Playing, Done }

    private const int Rows = 5;
    private const double GameSeconds = 60;
    private const double PenaltySeconds = 3;
    private static readonly TimeSpan LeftRefillDelay = TimeSpan.FromMilliseconds(900);
    private static readonly TimeSpan RightRefillDelay = TimeSpan.FromMilliseconds(1300);

    [Parameter, EditorRequired] public IReadOnlyList<Word> AllWords { get; set; } = default!;
    [Parameter, EditorRequired] public List<Word> GroupWords { get; set; } = default!;
    [Parameter, EditorRequired] public Func<Word, CardState?> StateOf { get; set; } = default!;
    [Parameter] public int Best { get; set; }
    [Parameter] public EventCallback<int> OnFinished { get; set; }

    private readonly GameClock clock = new();
    private Phase phase = Phase.Ready;
    private WordDealer? dealer;

    // What's on the board, and what's waiting to drop into an empty spot.
    private readonly Word?[] left = new Word?[Rows];
    private readonly Word?[] right = new Word?[Rows];
    private readonly Word?[] leftPending = new Word?[Rows];
    private readonly Word?[] rightPending = new Word?[Rows];
    private readonly DateTime[] leftRefillAt = new DateTime[Rows];
    private readonly DateTime[] rightRefillAt = new DateTime[Rows];

    // The one Spanish word whose English isn't out yet, and the one English whose Spanish isn't out yet.
    private Word? orphanLeft, orphanRight;
    private int refills;

    private int? selLeft, selRight;
    private int? badLeft, badRight;
    private DateTime flashUntil;
    private int score, previousBest;
    private readonly List<Word> mistakes = new();

    private string TileClass(bool isLeft, int i, bool empty)
    {
        if (empty) return "empty";
        if ((isLeft ? badLeft : badRight) == i) return "bad";
        return (isLeft ? selLeft : selRight) == i ? "sel" : "";
    }

    private void Start()
    {
        dealer = new WordDealer(GamePicker.Pool(GroupWords, AllWords, StateOf, min: Rows + 3), StateOf, 15);
        Array.Clear(left);
        Array.Clear(right);
        Array.Clear(leftPending);
        Array.Clear(rightPending);
        mistakes.Clear();
        selLeft = selRight = badLeft = badRight = null;
        orphanLeft = orphanRight = null;
        score = refills = 0;
        previousBest = Best;

        // 4 full pairs + 1 Spanish whose English comes later + 1 English whose Spanish comes later.
        var start = new List<Word>();
        for (var k = 0; k < Rows + 1; k++)
        {
            var w = Draw(start);
            if (w is not null) start.Add(w);
        }

        if (start.Count == Rows + 1)
        {
            orphanLeft = start[Rows - 1];
            orphanRight = start[Rows];
            var lefts = start.Take(Rows).ToArray();
            var rights = start.Take(Rows - 1).Append(orphanRight).ToArray();
            Random.Shared.Shuffle(lefts);
            Random.Shared.Shuffle(rights);
            lefts.CopyTo(left, 0);
            rights.CopyTo(right, 0);
        }
        else
        {
            // Tiny word list: plain pairs.
            var pairs = start.Take(Rows).ToArray();
            pairs.CopyTo(left, 0);
            Random.Shared.Shuffle(pairs);
            pairs.CopyTo(right, 0);
        }

        phase = Phase.Playing;
        clock.Start(GameSeconds, Tick, Finish);
    }

    /// <summary>Next word that isn't on the board, waiting to drop in, or sharing a meaning with one of those.</summary>
    private Word? Draw(IEnumerable<Word>? alsoAvoid = null)
    {
        var inPlay = left.Concat(right).Concat(leftPending).Concat(rightPending)
            .Append(orphanLeft).Append(orphanRight)
            .Concat(alsoAvoid ?? Enumerable.Empty<Word>())
            .Where(w => w is not null).Select(w => w!).ToList();
        var meanings = inPlay.Select(w => w.En).ToHashSet();
        return dealer!.Next(w => !inPlay.Contains(w) && !meanings.Contains(w.En));
    }

    private void TapLeft(int i)
    {
        if (left[i] is null) return;
        selLeft = selLeft == i ? null : i;
        TryMatch();
    }

    private void TapRight(int i)
    {
        if (right[i] is null) return;
        selRight = selRight == i ? null : i;
        TryMatch();
    }

    private void TryMatch()
    {
        if (selLeft is not int a || selRight is not int b) return;
        var es = left[a]!;
        var en = right[b]!;
        selLeft = selRight = null;

        if (ReferenceEquals(es, en) || es.En == en.En)
        {
            score++;
            left[a] = null;
            right[b] = null;
            badLeft = badRight = null;
            ScheduleRefill(a, b);
        }
        else
        {
            clock.Penalty(PenaltySeconds);
            badLeft = a;
            badRight = b;
            flashUntil = DateTime.UtcNow.AddMilliseconds(450);
            if (!mistakes.Contains(es)) mistakes.Add(es);
        }
    }

    /// <summary>
    /// Fill the two empty spots after a short pause. Each time, one waiting word gets its partner
    /// and one brand-new word starts waiting – alternating sides – so the two new tiles never match each other.
    /// </summary>
    private void ScheduleRefill(int a, int b)
    {
        Word? newLeft, newRight;
        if (refills % 2 == 0)
        {
            newRight = orphanLeft;          // the waiting Spanish word gets its English
            newLeft = Draw();               // a new Spanish word starts waiting
            orphanLeft = newLeft;
        }
        else
        {
            newLeft = orphanRight;          // the waiting English gets its Spanish
            newRight = Draw();              // a new English starts waiting
            orphanRight = newRight;
        }
        refills++;

        var now = DateTime.UtcNow;
        leftPending[a] = newLeft;
        leftRefillAt[a] = now + LeftRefillDelay;
        rightPending[b] = newRight;
        rightRefillAt[b] = now + RightRefillDelay;
    }

    private Task Tick()
    {
        var now = DateTime.UtcNow;
        for (var i = 0; i < Rows; i++)
        {
            if (left[i] is null && leftPending[i] is not null && now >= leftRefillAt[i])
            {
                left[i] = leftPending[i];
                leftPending[i] = null;
            }
            if (right[i] is null && rightPending[i] is not null && now >= rightRefillAt[i])
            {
                right[i] = rightPending[i];
                rightPending[i] = null;
            }
        }
        if (now > flashUntil) badLeft = badRight = null;
        return InvokeAsync(StateHasChanged);
    }

    private async Task Finish()
    {
        phase = Phase.Done;
        await InvokeAsync(StateHasChanged);
        await OnFinished.InvokeAsync(score);
    }

    public void Dispose() => clock.Dispose();
}
