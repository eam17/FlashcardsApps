    private async Task ImportFile(InputFileChangeEventArgs e)
    {
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 60_000_000);
            using var reader = new StreamReader(stream);
            var text = await reader.ReadToEndAsync();

            // Texts and your own words first, so the progress on your own words can be matched.
            var (texts, myWords) = ProgressTransfer.ReadReading(text, e.File.Name);
            if (texts is not null) progress.Texts = texts;
            if (myWords is not null) progress.MyWords = myWords;
            RebuildWords();

            var result = ProgressTransfer.Import(text, e.File.Name, words!);
            progress.Cards = result.Cards;
            // Older exports and CSV files have no verb progress: keep what's on this device.
            if (result.VerbSkills is not null)
            {
                progress.VerbSkills = result.VerbSkills;
                progress.VerbTests = result.VerbTests ?? new();
            }
            // The schedule settings and the review history (Export JSON from October 2026).
            var (scheduler, importedLog) = ProgressTransfer.ReadHistory(text, e.File.Name);
            if (scheduler is not null)
            {
                progress.Retention = scheduler.Retention is >= 0.7 and <= 0.97 ? scheduler.Retention : Fsrs.DefaultRetention;
                progress.FsrsParameters = scheduler.Parameters is { } sp && Fsrs.Validate(sp) is null ? sp : null;
                Fsrs.Configure(progress.FsrsParameters, progress.Retention);
                paramsText = progress.FsrsParameters is { } mine ? Fsrs.Format(mine) : "";
            }
            var historyNote = "";
            if (importedLog is not null)
            {
                historyNote = await Store.ReplaceLogAsync(importedLog)
                    ? $" Review history: {importedLog.Count:N0} answers."
                    : " The review history couldn't be saved in this browser.";
                history = importedLog;
            }
            practiceIdx = 0;
            currentId = null;
            ResetCardView();
            skipped.Clear();
            await Store.SaveAsync(progress);

            var msg = $"Imported {result.Learned} learned and {result.Learning} still-learning words from {e.File.Name}.{historyNote}";
            if (result.Unknown > 0) msg += $" {result.Unknown} words weren't in the app's list and were skipped.";
            msg += result.VerbSkills is null
                ? " The file has no verb progress, so your verb progress on this device was kept."
                : $" Verb progress: {result.VerbSkills.Count} practised forms.";
            ShowTransfer(msg);
        }
        catch (Exception ex)
        {
            ShowTransfer($"Couldn't import {e.File.Name}: {ex.Message}", error: true);
        }
    }

    private void ShowTransfer(string message, bool error = false)
    {
        transferMessage = message;
        transferError = error;
    }

    private async Task Reset()
    {
        currentId = null;
        progress.Cards = new();
        progress.VerbSkills = new();
        progress.VerbRotation = new();
        progress.VerbTests = new();
        progress.Order = null;
        progress.ReviewsDoneToday = 0;
        progress.NewDoneToday = 0;
        await Store.ClearLogAsync();
        history = new();
        practiceIdx = 0;
        keepGoing = false;
        ResetCardView();
        skipped.Clear();
        notice = null;
        await Store.SaveAsync(progress);
    }
