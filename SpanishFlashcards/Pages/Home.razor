    private static string Pct(double x) => $"{Math.Round(x * 100):0}%";

    /// <summary>The average chance of remembering the words in reviews today (null when there are none).</summary>
    private double? RecallNow()
    {
        var chances = progress.Cards.Values.Select(c => Srs.Recall(c, today)).OfType<double>().ToList();
        return chances.Count == 0 ? null : chances.Average();
    }

    private int RetentionPercent
    {
        get => (int)Math.Round(progress.Retention * 100);
        set => progress.Retention = Math.Clamp(value, 70, 97) / 100.0;
    }

    private Task RetentionChanged()
    {
        Fsrs.Configure(progress.FsrsParameters, progress.Retention);
        return SaveProgress();
    }

    private async Task ApplyParameters()
    {
        if (!Fsrs.TryParse(paramsText, out var p, out var error))
        {
            paramsMessage = $"Not changed: {error}";
            paramsError = true;
            return;
        }
        progress.FsrsParameters = p;
        Fsrs.Configure(progress.FsrsParameters, progress.Retention);
        paramsText = Fsrs.Format(p);
        paramsMessage = "Now using your own settings. They apply from each word's next answer.";
        paramsError = false;
        await SaveProgress();
    }

    private async Task StandardParameters()
    {
        progress.FsrsParameters = null;
        Fsrs.Configure(null, progress.Retention);
        paramsText = "";
        paramsMessage = "Back to the standard settings.";
        paramsError = false;
        await SaveProgress();
    }

