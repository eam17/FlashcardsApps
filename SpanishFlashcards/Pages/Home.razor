@page "/"
@inject WordRepository Repo
@inject ProgressStore Store
@inject IJSRuntime JS

<PageTitle>Palabras · Spanish flashcards</PageTitle>

@if (words is null)
{
    <div class="loading">Cargando palabras…</div>
}
else
{
    EnsureReviewDay();
    var group = CurrentGroup;
    var groupWords = words.Where(group.Includes).ToList();
    var groupLearned = groupWords.Count(w => Srs.IsLearned(State(w)));
    var required = RequiredReviewIds();
    var groupRequired = groupWords.Count(w => required.Contains(w.Es));

    <div class="app">
        <header class="top">
            <div class="top-row">
                <h1>@ScreenTitle</h1>
                @if (tab != Tab.Verbs)
                {
                    <div class="score" title="Words learned">
                        <span class="score-num">@LearnedCount</span><span class="score-of">/@words.Count learned</span>
                    </div>
                }
            </div>
            @if (tab != Tab.Verbs)
            {
                <div class="progress" role="progressbar" aria-label="Words learned"
                     aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Percent">
                    <div class="progress-fill" style="width: @(Percent)%"></div>
                </div>
            }
        </header>

        @* ---------- group picker: frequency groups, topics, tricky words ---------- *@
        @if (tab is not (Tab.Settings or Tab.Verbs or Tab.Read))
        {
        <div class="group-picker" role="group" aria-label="Word group">
            <button type="button" class="tool icon" aria-label="Previous group"
                    disabled="@(GroupIndex <= 0)" @onclick="() => StepGroup(-1)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
            </button>
            <select class="group-select" aria-label="Choose a word group" @bind="groupId" @bind:after="OnGroupChanged">
                @foreach (var section in groups.GroupBy(g => g.Section))
                {
                    if (section.Key == "")
                    {
                        foreach (var g in section)
                        {
                            <option value="@g.Id">@g.Label</option>
                        }
                    }
                    else
                    {
                        <optgroup label="@section.Key">
                            @foreach (var g in section)
                            {
                                <option value="@g.Id">@g.Label</option>
                            }
                        </optgroup>
                    }
                }
            </select>
            <button type="button" class="tool icon" aria-label="Next group"
                    disabled="@(GroupIndex >= groups.Count - 1)" @onclick="() => StepGroup(1)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
            </button>
        </div>
        }
        @if (tab is Tab.Words or Tab.Games)
        {
            <div class="group-progress">@groupLearned of @groupWords.Count learned · @groupRequired reviews left today</div>
        }

        <main class="content">
            @if (tab == Tab.Study)
            {
                var newGoalMet = NewGoalMet;
                var studyQueue = ReviewQueue(groupWords, required, includeNew: !newGoalMet);
                var newLeft = newGoalMet ? groupWords.Count(w => Srs.IsNew(State(w))) : 0;
                var extraQueue = ExtraQueue(groupWords);
                // Extra practice only starts when nothing that counts is left (and you tapped Keep going).
                // A word you just got wrong in extra practice waits one card before it comes back.
                // A card already on screen in extra practice stays there (a check-in coming due mustn't replace it).
                onExtra = keepGoing && extraQueue.Count > 0
                          && (studyQueue.Count == 0 || studyQueue.All(w => w.Es == lastAnswered)
                              || (onExtra && currentId is not null && extraQueue.Any(w => w.Es == currentId)));
                var queue = onExtra ? extraQueue : studyQueue;
                var waitFor = onExtra ? null : WaitingFor(studyQueue);
                var card = waitFor is null ? CurrentCard(queue) : null;

                <div class="status-row @(onExtra ? "extra" : "")">
                    <span class="status-text">
                        @if (onExtra)
                        {
                            <text>Extra practice · doesn't change when words come back</text>
                        }
                        else
                        {
                            var learningN = words.Count(w => Srs.IsLearning(State(w)));
                            var reviewN = studyQueue.Count(w => Srs.IsDue(State(w), today));
                            var bonusN = Math.Max(0, reviewN - groupRequired);
                            var first = groupRequired == 0 && progress.ReviewsDoneToday > 0
                                ? "Reviews done"
                                : $"{groupRequired} reviews left";
                            var learningText = learningN > 0 ? $" · {learningN} learning" : "";
                            var bonusText = bonusN > 0 ? $" · {bonusN} bonus reviews" : "";
                            var checkN = words.Count(w => IsCheckIn(State(w)));
                            var checkText = checkN > 0 ? $" · {checkN} {(checkN == 1 ? "check-in" : "check-ins")}" : "";
                            <text>@($"{first} · {NewTodayText}{learningText}{checkText}{bonusText}")</text>
                        }
                    </span>
                </div>

                @if (waitFor is not null && State(waitFor) is { DueAt: { } waitDue })
                {
                    if (wakeFor != waitDue) { wakeFor = waitDue; _ = WakeAt(waitDue); }
                    <div class="done">
                        <div class="done-title">Un momento…</div>
                        <p>@WaitText(waitFor, waitDue)</p>
                        <button type="button" class="tool" @onclick="() => { waitSkipped = waitFor.Es; currentId = waitFor.Es; }">Show it now</button>
                    </div>
                }
                else if (card is not null)
                {
                    var state = State(card);
                    shownCardKey = $"{card.Es}|{state?.Phase}|{state?.Step}|{answerCount}|{onExtra}";
                    var mode = ModeFor(state);
                    var englishFirst = EnglishFirstFor(state);
                    var kind = ChoiceKindFor(state);
                    var choiceMode = kind != ChoiceKind.None;
                    if (choiceMode) EnsureChoices(card, kind, state);
                    var showAnswer = mode == CardMode.Intro || flipped;
                    var typing = progress.TypeAnswers && mode == CardMode.Recall && englishFirst;
                    var spanishVisible = showAnswer || !englishFirst;
                    var cloze = card.ClozeParts;

                    <div class="study">
                        <div class="card-wrap">
                            <button type="button" class="card @(showAnswer ? "back" : "front") @(mode == CardMode.Intro ? "intro" : "")"
                                    @onclick="() => Reveal(englishFirst)" disabled="@(choiceMode || mode == CardMode.Intro || flipped || typing)"
                                    aria-label="@CardAria(card, mode, englishFirst)">
                                <div class="card-meta">
                                    <span>@card.Tag</span>
                                    <span class="dots" title="@Srs.StageLabel(state)">
                                        @for (var i = 1; i <= 5; i++)
                                        {
                                            <span class="dot @(Srs.Strength(state) >= i ? "on" : "")"></span>
                                        }
                                    </span>
                                </div>
                                <div class="card-status">@CardStatus(state, required.Contains(card.Es))</div>

                                @if (mode == CardMode.Intro)
                                {
                                    @* A new word: everything at once, to read and hear before it's tested. *@
                                    <div class="card-ask">New word</div>
                                    <SpanishWord Word="card" />
                                    <div class="card-answer">@card.En</div>
                                    <div class="card-example">
                                        @if (cloze is not null)
                                        {
                                            <text>@(cloze.Value.Before)<mark>@card.Form</mark>@(cloze.Value.After)</text>
                                        }
                                        else
                                        {
                                            @card.Example
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(card.ExampleEn))
                                    {
                                        <div class="card-sub">@card.ExampleEn</div>
                                    }
                                    @ConjugationBox(card)
                                }
                                else if (!showAnswer && englishFirst)
                                {
                                    @* English first: meaning + Spanish sentence with the word blanked *@
                                    <div class="card-ask">Answer in Spanish</div>
                                    <div class="card-word en">@card.En</div>
                                    <div class="card-pos">@card.Pos</div>
                                    <div class="card-example">
                                        @if (cloze is not null)
                                        {
                                            <text>@(cloze.Value.Before)<span class="blank">_____</span>@(cloze.Value.After)</text>
                                        }
                                        else
                                        {
                                            @card.Example
                                        }
                                    </div>
                                    <div class="card-hint">@(choiceMode ? "Pick the Spanish word below" : typing ? "Type the Spanish word below" : "Say the Spanish word, then tap to check")</div>
                                }
                                else if (!showAnswer)
                                {
                                    @* Spanish first *@
                                    <div class="card-ask">Answer in English</div>
                                    <SpanishWord Word="card" />
                                    <div class="card-example">@card.Example</div>
                                    <div class="card-hint">@(choiceMode ? "Pick the meaning below" : "Say the meaning, then tap to check")</div>
                                }
                                else
                                {
                                    @* Answer side (same for both directions) *@
                                    <SpanishWord Word="card" />
                                    <div class="card-answer">@card.En</div>
                                    <div class="card-example">
                                        @if (cloze is not null)
                                        {
                                            <text>@(cloze.Value.Before)<mark>@card.Form</mark>@(cloze.Value.After)</text>
                                        }
                                        else
                                        {
                                            @card.Example
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(card.ExampleEn))
                                    {
                                        <div class="card-sub">@card.ExampleEn</div>
                                    }
                                    @ConjugationBox(card)
                                }
                            </button>

                            @if (notice is not null)
                            {
                                <p class="toast @(noticeSlow ? "slow" : "")" role="status">
                                    @if (noticeSlow)
                                    {
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                                    }
                                    <span>@notice</span>
                                </p>
                            }

                            @if (canSpeak && spanishVisible)
                            {
                                <div class="speak">
                                    <button type="button" class="speak-btn" aria-label="Say the word" title="Say the word"
                                            @onclick="() => Speak(SpeakableWord(card))">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z" /><path d="M15.5 8.5a5 5 0 0 1 0 7" /></svg>
                                    </button>
                                    <button type="button" class="speak-btn" aria-label="Say the example sentence" title="Say the sentence"
                                            @onclick="() => Speak(card.Example)">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z" /><path d="M15.5 8.5a5 5 0 0 1 0 7" /><path d="M18.5 5.5a9 9 0 0 1 0 13" /></svg>
                                    </button>
                                </div>
                            }
                        </div>

                        @if (mode == CardMode.Intro)
                        {
                            <div class="actions two">
                                <button type="button" class="act skip" @onclick="() => AlreadyKnowIt(card)">I already know it</button>
                                <button type="button" class="act known" @onclick="() => MeetWord(card)">Got it</button>
                            </div>
                            <p class="choice-outcome">Next: pick the meaning, then the Spanish, then recall the Spanish yourself.</p>
                        }
                        else if (choiceMode && picked is null)
                        {
                            @* Multiple choice: 6 options *@
                            <div class="choices" role="group" aria-label="@(kind == ChoiceKind.Spanish ? "Choose the Spanish word" : "Choose the meaning")">
                                @foreach (var opt in choices)
                                {
                                    <button type="button" class="choice @(kind == ChoiceKind.Spanish ? "es" : "")" @onclick="() => Choose(opt, card, kind)">
                                        @(kind == ChoiceKind.Spanish ? opt.Es : opt.En)
                                    </button>
                                }
                            </div>
                            <button type="button" class="skip-link" @onclick="() => Skip(card)">Skip</button>
                        }
                        else if (choiceMode)
                        {
                            <div class="choices" aria-live="polite">
                                @foreach (var opt in choices)
                                {
                                    <div class="choice @(kind == ChoiceKind.Spanish ? "es" : "") @(opt.Es == card.Es ? "right" : opt.Es == picked?.Es ? "wrong" : "dim")">
                                        @(kind == ChoiceKind.Spanish ? opt.Es : opt.En)
                                        @if (opt.Es == card.Es && pickedSlow)
                                        {
                                            <span class="slow-mark" title="Right, but slow: one more try in a minute"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg></span>
                                        }
                                    </div>
                                }
                            </div>
                            <p class="choice-outcome">@ChoiceOutcome(card)</p>
                            <button type="button" class="primary wide" @onclick="() => ContinueAfterChoice(card)">
                                @(picked?.Es == card.Es ? "Correct! Continue" : "Continue")
                            </button>
                        }
                        else if (typing && !flipped)
                        {
                            @* Recall the Spanish and type it: checked for you (a missing accent or a slip counts as Hard). *@
                            <div class="vp-type">
                                <input id="word-answer" class="vp-input" type="text" lang="es" autocomplete="off" autocapitalize="off"
                                       autocorrect="off" spellcheck="false" placeholder="Type the Spanish" aria-label="Your answer in Spanish"
                                       @bind="typedText" @bind:event="oninput" @onkeydown="e => TypedKey(e, card)" />
                                <div class="vp-accents seven" role="group" aria-label="Letters with accents">
                                    @foreach (var ch in AccentKeys)
                                    {
                                        var c = ch;
                                        <button type="button" class="vp-key" @onclick="() => AddLetter(c)">@c</button>
                                    }
                                </div>
                                <button type="button" class="primary wide" disabled="@(string.IsNullOrWhiteSpace(typedText))" @onclick="() => CheckTyped(card)">Check</button>
                            </div>
                            <button type="button" class="skip-link" @onclick="() => DontKnow(card)">I don't know it</button>
                        }
                        else if (typing && typedResult is not null)
                        {
                            var tr = typedOverride ? WordCheckResult.Right : typedResult ?? WordCheckResult.Wrong;
                            <div class="game-feedback @(tr == WordCheckResult.Right ? "ok" : tr == WordCheckResult.Wrong ? "no" : "meh")" role="status">
                                <span class="fb-icon" aria-hidden="true">@(tr == WordCheckResult.Right ? "✓" : tr == WordCheckResult.Wrong ? "✗" : "~")</span>
                                <span class="fb-word">@TypedMessage(card)</span>
                            </div>
                            <div class="vp-next">
                                @if (!typedOverride && typedResult is not WordCheckResult.Right && !string.IsNullOrWhiteSpace(typedText))
                                {
                                    <button type="button" class="tool" @onclick="() => typedOverride = true">Count it as right</button>
                                }
                                <button id="word-continue" type="button" class="primary wide" @onclick="() => ContinueTyped(card)">Continue</button>
                            </div>
                            <p class="choice-outcome">@TypedOutcome(state)</p>
                        }
                        else if (!flipped)
                        {
                            <button type="button" class="primary wide" @onclick="() => Reveal(englishFirst)">Show answer</button>
                            <button type="button" class="skip-link" @onclick="() => Skip(card)">Skip</button>
                        }
                        else
                        {
                            @* Grade only after seeing the answer. *@
                            <div class="actions">
                                <button type="button" class="act learning" @onclick="() => ApplyRecall(card, Rating.Forgot, revealSlow)">Forgot</button>
                                <button type="button" class="act skip" @onclick="() => ApplyRecall(card, Rating.Hard, revealSlow)">Hard</button>
                                <button type="button" class="act known" @onclick="() => ApplyRecall(card, Rating.Good, revealSlow)">Got it</button>
                            </div>
                            <p class="choice-outcome">@GradeHint(state)</p>
                        }
                    </div>
                }
                else
                {
                    var nextDue = NextDueIn(groupWords);
                    var laterChecks = progress.CheckIns
                        ? words.Select(State).Where(s => Srs.HasCheckInLater(s, DateTime.UtcNow, today)).Select(s => s!.CheckIn!.Value).ToList()
                        : new List<DateTime>();
                    if (laterChecks.Count > 0 && wakeFor != laterChecks.Min()) { wakeFor = laterChecks.Min(); _ = WakeAt(laterChecks.Min()); }
                    <div class="done">
                        <div class="done-title">¡Muy bien!</div>
                        <p>
                            @if (newLeft > 0)
                            {
                                <span>@($"You've started your {progress.DailyNewLimit} new words for today and done your reviews. You're good for now!")</span>
                            }
                            else
                            {
                                <span>You're done with this group for today.</span>
                            }
                            @if (nextDue is not null)
                            {
                                <span> Next review: @(nextDue.Value.ToString("dddd, MMM d")).</span>
                            }
                        </p>
                        @if (laterChecks.Count > 0)
                        {
                            <p class="small">@CheckInLaterText(laterChecks)</p>
                        }
                        @if (newLeft > 0)
                        {
                            <button type="button" class="primary" @onclick="LearnMoreNew">Learn more new words</button>
                            <p class="small">@($"{newLeft} new words left in this group. More new words today means more reviews in the next few days.")</p>
                        }
                        @if (extraQueue.Count > 0)
                        {
                            <button type="button" class="@(newLeft > 0 ? "tool" : "primary")" @onclick="KeepGoing">@(newLeft > 0 ? "Practise words I've seen" : "Keep going")</button>
                            <p class="small">Extra practice doesn't change when words come back, unless you forget one.</p>
                        }
                    </div>
                }
            }
            else if (tab == Tab.Settings)
            {
                <div class="settings">
                    <section class="set-card">
                        <h2><label for="daily-limit">Daily reviews</label></h2>
                        <p>The most reviews you <em>have</em> to do each day. Anything over it shows up as optional extra reviews and rolls forward. New words are never limited.</p>
                        <select id="daily-limit" class="small-select" @bind="progress.DailyReviewLimit" @bind:after="SaveProgress">
                            <option value="10">10 a day</option>
                            <option value="20">20 a day</option>
                            <option value="30">30 a day</option>
                            <option value="50">50 a day</option>
                            <option value="100">100 a day</option>
                            <option value="0">No limit</option>
                        </select>
                    </section>

                    <section class="set-card">
                        <h2><label for="daily-new">New words a day</label></h2>
                        <p>After this many new words (and your reviews), Cards tells you you're done for today. You can always tap <strong>Learn more new words</strong> to keep going.</p>
                        <select id="daily-new" class="small-select" @bind="progress.DailyNewLimit" @bind:after="SaveProgress">
                            <option value="5">5 a day</option>
                            <option value="10">10 a day</option>
                            <option value="15">15 a day</option>
                            <option value="20">20 a day</option>
                            <option value="30">30 a day</option>
                            <option value="0">No goal</option>
                        </select>
                    </section>

                    <section class="set-card">
                        <h2>Answering in Spanish</h2>
                        <label class="check-row">
                            <input type="checkbox" @bind="progress.TypeAnswers" @bind:after="SaveProgress" />
                            <span>Type the Spanish (checked for you)</span>
                        </label>
                        <p>Recalling the Spanish yourself is what really shows you know a word. With this on, you type it and the app checks it. A missing accent still counts as remembered (you'll see the right spelling); the wrong article or a one-letter slip counts as Hard. <strong>Count it as right</strong> is there if the check gets it wrong. Off: say it, show the answer and grade yourself.</p>
                    </section>

                    <section class="set-card">
                        <h2>Check-in later today</h2>
                        <label class="check-row">
                            <input type="checkbox" @bind="progress.CheckIns" @bind:after="SaveProgress" />
                            <span>Check today's new words again later</span>
                        </label>
                        <p>A word you finish learning comes back once more about @Srs.CheckInHours hours later the same day, for a quick recall in Spanish. Remember it and nothing changes: its first review is still tomorrow. Forget it and you practise it again a minute later. Words learned in the evening skip it, since their first review is the next morning anyway. Check-ins don't count toward your review limit.</p>
                    </section>

                    <section class="set-card">
                        <h2>Answer timer</h2>
                        <p>How long you get before a right answer counts as a struggle. In the first steps a slow answer repeats the step; in a review, a slow "Got it" counts as Hard (the word comes back a bit sooner, and it's marked as a bit harder). The time runs until you pick an option, tap Check or tap Show answer. Typing the Spanish gets twice the Spanish time.</p>
                        <div class="timer-settings">
                            <label for="timer-en">Answer in English</label>
                            <select id="timer-en" class="small-select" @bind="progress.EnglishAnswerSeconds" @bind:after="SaveProgress">
                                @foreach (var sec in TimerChoices)
                                {
                                    <option value="@sec">@sec seconds</option>
                                }
                                <option value="0">No timer</option>
                            </select>
                            <label for="timer-es">Answer in Spanish</label>
                            <select id="timer-es" class="small-select" @bind="progress.SpanishAnswerSeconds" @bind:after="SaveProgress">
                                @foreach (var sec in TimerChoices)
                                {
                                    <option value="@sec">@sec seconds</option>
                                }
                                <option value="0">No timer</option>
                            </select>
                        </div>
                    </section>

                    <section class="set-card">
                        <h2>How well you remember</h2>
                        @if (history is null)
                        {
                            <p>Loading your review history…</p>
                        }
                        else
                        {
                            var stats = ReviewHistory.Stats(history);
                            @if (stats.Reviews < MinReviewsForStats)
                            {
                                <p>@($"Not enough reviews in the last 30 days to measure yet ({stats.Reviews} so far). After a couple of weeks of reviews this shows how often you remember the words that come back.")</p>
                            }
                            else
                            {
                                <p>Last 30 days: you remembered <strong>@Pct(stats.Rate)</strong> of @stats.Reviews reviews. The aim is @Pct(Fsrs.Retention).</p>
                                <ul class="set-list">
                                    @foreach (var (label, n, ok) in stats.ByGap)
                                    {
                                        <li>@($"After {label}: {Pct(n == 0 ? 0 : (double)ok / n)} of {n}")</li>
                                    }
                                </ul>
                                @if (stats.Rate < Fsrs.Retention - 0.05)
                                {
                                    <p class="small">A bit below the aim. Once you have a few months of history, the schedule can be fitted to your own memory (see below).</p>
                                }
                            }
                            @if (stats.CheckIns > 0)
                            {
                                <p>@($"Same-day check-ins: {Pct((double)stats.CheckInsRemembered / stats.CheckIns)} remembered ({stats.CheckIns}).")</p>
                            }
                            var recallNow = RecallNow();
                            @if (recallNow is { } r)
                            {
                                <p>@($"Estimate for right now: you'd remember about {Pct(r)} of the words in your reviews.")</p>
                            }
                            <p class="small">@($"{history.Count:N0} answers saved on this device. They're included in Export JSON.")</p>
                        }

                        <h3><label for="retention">Aim</label></h3>
                        <p>Each review is planned for the day your chance of remembering the word drops to this. Higher means you remember more, with more reviews a day; lower means fewer reviews and more forgetting. 90% suits most people. A change applies from each word's next review.</p>
                        <select id="retention" class="small-select" @bind="RetentionPercent" @bind:after="RetentionChanged">
                            <option value="85">85%</option>
                            <option value="90">90%</option>
                            <option value="95">95%</option>
                        </select>

                        <h3><label for="fsrs-params">Fit the schedule to you</label></h3>
                        <p>The schedule uses FSRS, the same memory model as Anki, with standard settings fitted to millions of reviews. After a few months of reviews, <strong>Download history</strong> gives the file an FSRS optimizer reads, and the 21 numbers it returns can go here to fit the schedule to your memory.</p>
                        <p class="small">@(Fsrs.UsingDefaults ? "Now using the standard settings." : "Now using your own settings.")</p>
                        <textarea id="fsrs-params" class="params-box" rows="3" spellcheck="false" @bind="paramsText" placeholder="@Fsrs.Format(Fsrs.DefaultParameters)"></textarea>
                        <div class="backup-buttons">
                            <button type="button" class="tool" @onclick="ApplyParameters">Use these</button>
                            <button type="button" class="tool" @onclick="StandardParameters">Back to standard</button>
                            <button type="button" class="tool" @onclick="ExportHistoryCsv">Download history</button>
                        </div>
                        @if (paramsMessage is not null)
                        {
                            <p class="backup-msg @(paramsError ? "error" : "")" role="status">@paramsMessage</p>
                        }
                    </section>

                    <section class="set-card">
                        <h2><label for="extra-dir">Extra practice</label></h2>
                        <p>After today's cards, <strong>Keep going</strong> lets you practice words you've already seen. Choose which side those cards show first.</p>
                        <select id="extra-dir" class="small-select" @bind="progress.PracticeDirection" @bind:after="SaveProgress">
                            <option value="auto">English first (answer in Spanish)</option>
                            <option value="es">Spanish first (answer in English)</option>
                        </select>
                    </section>

                    <section class="set-card">
                        <h2>Verbs</h2>
                        <label class="check-row">
                            <input type="checkbox" @bind="progress.ShowVosotros" @bind:after="VosotrosChanged" />
                            <span>Include <em lang="es">vosotros</em></span>
                        </label>
                        <p><em lang="es">Vosotros</em> (you all, informal) is used in Spain; Latin America says <em lang="es">ustedes</em> instead. Turn it off to hide it from the verb tables, practice, tests and scores. Your progress on it is kept.</p>
                    </section>

                    <section class="set-card">
                        <h2>Backup and transfer</h2>
                        <p>Your progress is saved in this browser only. Export it to keep a backup or to move it to another phone or browser, then Import it there. Import replaces the progress on that device. Verb progress is only in the JSON file (the CSV is a word list).</p>
                        <div class="backup-buttons">
                            <button type="button" class="tool" @onclick="ExportJson">Export JSON</button>
                            <button type="button" class="tool" @onclick="ExportCsv">Export CSV</button>
                            <label class="tool file">
                                Import…
                                <InputFile OnChange="ImportFile" accept=".json,.csv,application/json,text/csv" />
                            </label>
                        </div>
                        @if (transferMessage is not null)
                        {
                            <p class="backup-msg @(transferError ? "error" : "")" role="status">@transferMessage</p>
                        }
                    </section>

                    <section class="set-card" id="set-songs">
                        <h2><label for="audd-key">Song recognition</label></h2>
                        <p>The microphone on the Read tab uses AudD to tell which song is playing. It needs your own key: sign up at <a href="https://dashboard.audd.io" target="_blank" rel="noopener">dashboard.audd.io</a> (300 songs free, then about half a cent each) and paste the key here. It's kept only in this browser and only sent to AudD, never in backups or exports. Searching songs by name is free and needs no key.</p>
                        @if (auddKeyEnd is not null)
                        {
                            <p class="small">@($"Key saved (ends in {auddKeyEnd}). {progress.AuddUses} {(progress.AuddUses == 1 ? "song" : "songs")} sent to AudD from this device.")</p>
                        }
                        <div class="key-row">
                            <input id="audd-key" class="key-input" type="password" autocomplete="off" spellcheck="false"
                                   placeholder="@(auddKeyEnd is null ? "Paste your AudD key" : "Paste a new key to replace it")" @bind="auddKeyInput" @bind:event="oninput" />
                            <button type="button" class="tool" disabled="@(string.IsNullOrWhiteSpace(auddKeyInput))" @onclick="SaveAuddKey">Save</button>
                            @if (auddKeyEnd is not null)
                            {
                                <button type="button" class="tool" @onclick="RemoveAuddKey">Remove</button>
                            }
                        </div>
                        @if (auddMessage is not null)
                        {
                            <p class="backup-msg" role="status">@auddMessage</p>
                        }
                    </section>

                    <section class="set-card">
                        <h2>Pronunciation</h2>
                        @if (canSpeak)
                        {
                            <p>Words and sentences are read aloud with your device's Spanish voice.</p>
                            <button type="button" class="tool" @onclick="@(() => Speak("Hola, ¿qué tal? Vamos a aprender español."))">Test the voice</button>
                        }
                        else
                        {
                            <p>This browser doesn't offer speech, so the speaker buttons and Listen and tap are hidden. Try Safari (iPhone) or Chrome (Android).</p>
                        }
                    </section>

                    <section class="set-card">
                        <h2>How it works</h2>
                        <ul class="set-list">
                            <li><strong>New words</strong>: first a short introduction (meaning, example, sound). In the same session you then pick the meaning, a few minutes later pick the Spanish, and ten minutes after that recall the Spanish yourself. A miss comes back a minute later.</li>
                            <li><strong>Check-in</strong>: about @Srs.CheckInHours hours after you learn a word it comes back once for a quick recall, if that's still the same day (see above).</li>
                            <li><strong>Reviews</strong> start the next day and always ask for the Spanish: you see the English and type the Spanish (or say it and grade yourself, see above). Every answer updates the word's memory, and its next review is planned for when you're about to forget it (see <em>How well you remember</em>). Words you find easy spread out fast (a word you always get right comes back after about a week, then a month, then four months); hard ones come back more often. <strong>Hard</strong> grows the gap less and marks the word as a bit harder. <strong>Forgot</strong> gives a quick recall step a few minutes later and a much shorter gap.</li>
                            <li>A word counts as <strong>learned</strong> once its next review is about three weeks away (often after your second or third review). Learned words still come back now and then, further apart each time.</li>
                            <li>Your reviews come first, then new words (up to your daily goal). Each word counts once a day toward the review limit.</li>
                            <li>The app's day starts at 4 am, so a late-night session counts as that evening.</li>
                            <li>When you're done, <strong>Keep going</strong> gives you extra practice. It never pushes words further out, so it can't make a word look learned before it is.</li>
                            <li><strong>Mark learned</strong> in the Words list: the word never comes back.</li>
                            <li>Words you forget twice or more become <strong>tricky</strong> and show up more in games.</li>
                            <li><strong>Verbs</strong>: conjugation by tense, with rules and practice for each group. Separate from the word cards.</li>
                        </ul>
                    </section>

                    <section class="set-card danger">
                        <h2>Start over</h2>
                        <p>Deletes all your progress on this device. Export first if you might want it back.</p>
                        <button type="button" class="reset-btn" @onclick="ResetTapped">
                            @(confirmReset ? "Tap again to delete all progress" : "Reset all progress")
                        </button>
                    </section>
                </div>
            }
            else if (tab == Tab.Verbs)
            {
                <VerbsHub Progress="progress" OnProgressChanged="SaveProgress" CanSpeak="canSpeak" Speak="Speak" />
            }
            else if (tab == Tab.Read)
            {
                <ReadHub Words="words" StateOf="State" Progress="progress" OnChanged="ReadChanged" OnStudy="StudyGroup"
                         OnShowVerbs="() => SetTab(Tab.Verbs)" CanSpeak="canSpeak" Speak="Speak"
                         OnOpenSettings="OpenSongSettings" />
            }
            else if (tab == Tab.Games)
            {
                <GamesHub AllWords="words" GroupWords="groupWords" GroupLabel="@group.Label"
                          StateOf="State" Progress="progress" OnProgressChanged="SaveProgress"
                          CanSpeak="canSpeak" Speak="Speak" />
            }
            else
            {
                var learnedCount = groupLearned;
                var toLearnCount = groupWords.Count - groupLearned;
                var items = groupWords.Where(w => wordsFilter switch
                {
                    WordsFilter.ToLearn => !Srs.IsLearned(State(w)),
                    WordsFilter.Learned => Srs.IsLearned(State(w)),
                    _ => true,
                }).ToList();

                <div class="list-screen">
                    <div class="segmented words-filter" role="tablist" aria-label="Which words">
                        <button type="button" role="tab" class="seg @(wordsFilter == WordsFilter.ToLearn ? "on" : "")" aria-selected="@(wordsFilter == WordsFilter.ToLearn ? "true" : "false")" @onclick="() => wordsFilter = WordsFilter.ToLearn">@($"To learn ({toLearnCount})")</button>
                        <button type="button" role="tab" class="seg @(wordsFilter == WordsFilter.Learned ? "on" : "")" aria-selected="@(wordsFilter == WordsFilter.Learned ? "true" : "false")" @onclick="() => wordsFilter = WordsFilter.Learned">@($"Learned ({learnedCount})")</button>
                        <button type="button" role="tab" class="seg @(wordsFilter == WordsFilter.All ? "on" : "")" aria-selected="@(wordsFilter == WordsFilter.All ? "true" : "false")" @onclick="() => wordsFilter = WordsFilter.All">All</button>
                    </div>
                    <p class="list-hint">@WordsHint</p>

                    @if (items.Count == 0)
                    {
                        <div class="empty">
                            @(wordsFilter == WordsFilter.Learned
                                ? "Nothing here yet. Keep reviewing. Words land here after a few successful reviews."
                                : "You've learned every word in this group. ¡Enhorabuena!")
                        </div>
                    }
                    else
                    {
                        <div class="list">
                            <Virtualize Items="items" Context="w" ItemSize="68">
                                <div class="row">
                                    <div class="row-text">
                                        <div class="row-top">
                                            @if (w.IsNoun)
                                            {
                                                <span class="art-chip small @w.GenderClass" title="@w.GenderLabel">@w.ArticleChip</span>
                                            }
                                            <span class="row-word @w.GenderClass">@w.Es</span>
                                            <span class="badge @BadgeClass(State(w))">@Srs.StageLabel(State(w))</span>
                                            @if (Srs.IsTricky(State(w)))
                                            {
                                                <span class="badge tricky">tricky</span>
                                            }
                                        </div>
                                        <div class="row-sub">@w.En · @Srs.DueLabel(State(w), today)</div>
                                    </div>
                                    @{ var isLearned = Srs.IsLearned(State(w)); }
                                    <button type="button" class="tool"
                                            aria-label="@(isLearned ? $"Move back to learn: {w.Es}" : $"Mark as learned: {w.Es}")"
                                            @onclick="() => Move(w, isLearned)">@(isLearned ? "Relearn" : "Mark learned")</button>
                                </div>
                            </Virtualize>
                        </div>
                    }
                </div>
            }
        </main>

        <nav class="tabbar" aria-label="Sections">
            <button type="button" class="tab @(tab == Tab.Study ? "on" : "")" aria-pressed="@(tab == Tab.Study ? "true" : "false")" @onclick="() => SetTab(Tab.Study)">
                <span class="tab-pill">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="14" height="14" rx="2" /><path d="M7 3h12a2 2 0 0 1 2 2v12" /></svg>
                    <span class="tab-count" title="Reviews left today">@groupRequired</span>
                </span>
                Cards
            </button>
            <button type="button" class="tab @(tab == Tab.Words ? "on" : "")" aria-pressed="@(tab == Tab.Words ? "true" : "false")" @onclick="() => SetTab(Tab.Words)">
                <span class="tab-pill">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6h11" /><path d="M9 12h11" /><path d="M9 18h11" /><circle cx="4.5" cy="6" r="1" /><circle cx="4.5" cy="12" r="1" /><circle cx="4.5" cy="18" r="1" /></svg>
                    <span class="tab-count" title="Words to learn">@(groupWords.Count - groupLearned)</span>
                </span>
                Words
            </button>
            <button type="button" class="tab @(tab == Tab.Read ? "on" : "")" aria-pressed="@(tab == Tab.Read ? "true" : "false")" @onclick="() => SetTab(Tab.Read)">
                <span class="tab-pill">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z" /><path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z" /></svg>
                </span>
                Read
            </button>
            <button type="button" class="tab @(tab == Tab.Verbs ? "on" : "")" aria-pressed="@(tab == Tab.Verbs ? "true" : "false")" @onclick="() => SetTab(Tab.Verbs)">
                <span class="tab-pill">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12h-8" /><path d="M21 6H8" /><path d="M21 18h-8" /><path d="M3 6v4c0 1.1.9 2 2 2h3" /><path d="M3 10v6c0 1.1.9 2 2 2h3" /></svg>
                </span>
                Verbs
            </button>
            <button type="button" class="tab @(tab == Tab.Games ? "on" : "")" aria-pressed="@(tab == Tab.Games ? "true" : "false")" @onclick="() => SetTab(Tab.Games)">
                <span class="tab-pill">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" /></svg>
                </span>
                Games
            </button>
            <button type="button" class="tab @(tab == Tab.Settings ? "on" : "")" aria-pressed="@(tab == Tab.Settings ? "true" : "false")" @onclick="() => SetTab(Tab.Settings)">
                <span class="tab-pill">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" /></svg>
                </span>
                Settings
            </button>
        </nav>
    </div>
}

@code {
    private enum Tab { Study, Words, Read, Verbs, Games, Settings }
    private enum WordsFilter { ToLearn, Learned, All }
    private WordsFilter wordsFilter = WordsFilter.ToLearn;

    private string WordsHint => wordsFilter switch
    {
        WordsFilter.Learned => "A word counts as learned once its next review is about three weeks away, often after your second or third review (it keeps coming back, further apart each time), or when you tap Mark learned (those never come back). Tap Relearn to practise a word from the start.",
        WordsFilter.ToLearn => "New words start with a short introduction, then you pick the meaning and the Spanish. After that they come back for reviews, further apart each time you remember them. Tap Mark learned for a word you already know.",
        _ => "Every word in this group. Mark learned skips a word for good; Relearn brings it back.",
    };
    private enum ChoiceKind { None, English, Spanish }

    /// <summary>What the card on screen asks: meet a new word, pick from options, or recall it yourself.</summary>
    private enum CardMode { Intro, PickEnglish, PickSpanish, Recall }

    private sealed record GroupDef(string Id, string Label, string Section, Func<Word, bool> Includes);

    private IReadOnlyList<Word>? words;
    /// <summary>The word list, 2,000 words (words also has your own words from the Read tab).</summary>
    private IReadOnlyList<Word> baseWords = [];
    private Dictionary<string, Word> byId = new();
    /// <summary>Every spelling in the word list, for the typed-answer check (papa isn't papá, coger isn't comer).</summary>
    private HashSet<string> listSpellings = new();
    private Progress progress = new();
    private List<GroupDef> groups = new();

    private DateOnly today = Srs.Today;
    private Tab tab = Tab.Study;
    private bool keepGoing;   // tapped Keep going: extra practice after today's cards
    private DateOnly? moreNewOn;   // tapped Learn more new words (that day only)
    private bool onExtra;     // the card on screen is extra practice (set while rendering)
    private string groupId = "freq:1";
    private bool flipped;
    private int practiceIdx;
    private string? lastAnswered;
    private string? currentId;     // the card on screen (kept until answered or skipped)
    private string? waitSkipped;   // "Show it now" on the short wait before a learning step
    private DateTime? wakeFor;     // a re-draw is planned for this time
    private int answerCount;       // goes up with every answer or skip (restarts the timer even for the same card)
    private readonly HashSet<string> skipped = new();
    private string? notice;      // a short message over the bottom of the card ("Next review in 8 days")
    private bool noticeSlow;     // ...with a clock: the answer was slow
    private bool revealSlow;     // the answer was shown after the time limit (Settings → Answer timer)
    private int noticeVersion;
    private bool confirmReset;
    private bool canSpeak;

    // Multiple choice for the card on screen
    private string? choiceKey;
    private List<Word> choices = new();
    private Word? picked;
    // After picking an option: what will happen to the card, shown before Continue and applied on Continue.
    private CardState? pendingNext;
    private bool pickedSlow;

    // Answer timer: a right answer slower than the limit in Settings repeats a learning step, or counts as Hard in a review.
    private static readonly int[] TimerChoices = [2, 3, 4, 5, 6, 7, 8, 10, 12, 15];
    private string? shownCardKey;  // the card on screen (set while rendering)
    private string? timedCardKey;  // the card the timer was started for

    private string? transferMessage;
    private bool transferError;

    // Review history and the schedule settings (Settings → How well you remember)
    private const int MinReviewsForStats = 20;
    private List<ReviewEntry>? history;   // loaded when Settings opens; answers are added as you go
    private int lastAnswerMs;             // time taken by the answer being saved (for the history)
    private Rating? pendingRating;        // the rating of a multiple-choice pick, saved on Continue
    private string paramsText = "";
    private string? paramsMessage;
    private bool paramsError;

    protected override async Task OnInitializedAsync()
    {
        baseWords = await Repo.GetAllAsync();
        progress = await Store.LoadAsync();
        RebuildWords();

        if (progress.Group is { } g && groups.Any(x => x.Id == g)) groupId = g;
        VerbSettings.Vosotros = progress.ShowVosotros;
        if (progress.PracticeDirection == "en") progress.PracticeDirection = "auto"; // the two options became one
    }

    /// <summary>The word list plus your own words (Read tab), and the groups (including one per text).</summary>
    private void RebuildWords()
    {
        var all = baseWords.Concat(progress.MyWords.Select((m, i) => m.ToWord(baseWords.Count + i + 1))).ToList();
        byId = new Dictionary<string, Word>();
        foreach (var w in all) byId.TryAdd(w.Es, w);
        all = all.Where(w => byId[w.Es] == w).ToList();
        groups = BuildGroups(all);

        // Saved progress for words that aren't in the current list is kept (never deleted),
        // so editing words.json can't wipe anything; it just isn't shown.
        if (progress.Order is null || progress.Order.Count != all.Count || progress.Order.Any(id => !byId.ContainsKey(id)))
            progress.Order = null;
        if (!groups.Any(x => x.Id == groupId)) groupId = "freq:1";
        listSpellings = WordCheck.Spellings(all);
        words = all;
    }

    /// <summary>The Read tab changed your texts or words: save, and rebuild the words and groups.</summary>
    private async Task ReadChanged()
    {
        RebuildWords();
        await SaveProgress();
    }

    /// <summary>From the Read tab: study a text's words on the Cards tab.</summary>
    private async Task StudyGroup(string id)
    {
        RebuildWords();
        if (!groups.Any(x => x.Id == id)) return;
        groupId = id;
        SetTab(Tab.Study);
        await OnGroupChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A new card is on screen: start its answer timer.
        if (tab == Tab.Study && shownCardKey is not null && shownCardKey != timedCardKey)
        {
            timedCardKey = shownCardKey;
            try { await JS.InvokeVoidAsync("palabras.timerStart"); }
            catch (Exception) { }
            if (progress.TypeAnswers) focusFor = "answer";
        }
        if (scrollTo is { } target && tab == Tab.Settings)
        {
            scrollTo = null;
            try { await JS.InvokeVoidAsync("palabras.scrollToId", target); }
            catch (Exception) { }
        }
        if (focusFor is { } which)
        {
            focusFor = null;
            try { await JS.InvokeVoidAsync("palabras.focusById", which == "continue" ? "word-continue" : "word-answer"); }
            catch (Exception) { }
        }
        if (!firstRender) return;
        // Ask the browser to keep this site's storage even when the phone is low on space.
        try { await JS.InvokeAsync<bool>("palabras.persistStorage"); }
        catch (Exception) { }
        try { canSpeak = await JS.InvokeAsync<bool>("palabras.canSpeak"); }
        catch (Exception) { canSpeak = false; }
        if (canSpeak) StateHasChanged();
    }

    private List<GroupDef> BuildGroups(IReadOnlyList<Word> all)
    {
        var list = new List<GroupDef>
        {
            new("all", $"All {all.Count:N0} words", "", _ => true),
            new("tricky", "Tricky words (forgotten often)", "", w => Srs.IsTricky(State(w))),
        };
        for (var start = 1; start <= baseWords.Count; start += 100)
        {
            var band = Word.BandFor(start);
            list.Add(new($"freq:{start}", $"Words {band}", "By frequency", w => w.Band == band));
        }
        foreach (var topic in all.Select(w => w.Topic).Distinct().OrderBy(t => t, StringComparer.CurrentCulture))
        {
            var count = all.Count(w => w.Topic == topic);
            list.Add(new($"topic:{topic}", $"{topic} ({count})", "By topic", w => w.Topic == topic));
        }
        foreach (var text in progress.Texts.Where(t => t.Study.Count > 0).OrderByDescending(t => t.Added))
        {
            var t = text;
            list.Add(new($"text:{t.Id}", $"{t.Title} ({t.Study.Count})", "From your texts", w => t.Study.Contains(w.Es)));
        }
        return list;
    }

    // ----- derived state -----

    private GroupDef CurrentGroup => groups.FirstOrDefault(g => g.Id == groupId) ?? groups[0];

    private int GroupIndex => groups.FindIndex(g => g.Id == groupId);

    private CardState? State(Word w) => progress.Cards.TryGetValue(w.Es, out var s) ? s : null;

    private int LearnedCount => words is null ? 0 : words.Count(w => Srs.IsLearned(State(w)));

    private int Percent => words is { Count: > 0 } ? (int)Math.Round(LearnedCount * 100.0 / words.Count) : 0;

    private string Kicker => tab switch
    {
        Tab.Study => "Palabras",
        Tab.Games => "Play",
        _ => "Your words",
    };

    private string ScreenTitle => tab switch
    {
        Tab.Study => "Learn",
        Tab.Games => "Games",
        Tab.Read => "Read",
        Tab.Verbs => "Verbs",
        Tab.Settings => "Settings",
        _ => "Words",
    };

    /// <summary>Start a fresh daily review counter when the day changes.</summary>
    private void EnsureReviewDay()
    {
        today = Srs.Today;
        if (progress.ReviewDay != today)
        {
            progress.ReviewDay = today;
            progress.ReviewsDoneToday = 0;
            progress.NewDoneToday = 0;
        }
    }

    /// <summary>
    /// The due reviews you HAVE to do today, across all words: up to the daily limit minus what
    /// you've already done. The shortest gaps (the most fragile words) and the most overdue go first;
    /// the rest wait as optional bonus reviews and roll forward to later days.
    /// </summary>
    private HashSet<string> RequiredReviewIds()
    {
        var limit = progress.DailyReviewLimit;
        var left = limit <= 0 ? int.MaxValue : Math.Max(0, limit - progress.ReviewsDoneToday);
        if (left == 0 || words is null) return new HashSet<string>();
        return words
            .Where(w => Srs.IsDue(State(w), today))
            .OrderBy(w => State(w)!.Interval)
            .ThenBy(w => State(w)!.Due)
            .ThenBy(w => w.Rank)
            .Take(left)
            .Select(w => w.Es)
            .ToHashSet();
    }

    /// <summary>
    /// What Cards shows next: learning steps that are due (a word you just met or missed comes back a few
    /// cards later), then required reviews, then new words, then bonus reviews, and finally learning steps
    /// that aren't quite due yet (so a session can finish what it started). Skipped cards go last.
    /// </summary>
    private List<Word> ReviewQueue(List<Word> groupWords, HashSet<string> required, bool includeNew = true)
    {
        var now = DateTime.UtcNow;
        // Learning steps come from every word, whatever group is picked: they can't wait until you come back.
        var steps = words!
            .Where(w => Srs.IsStepDue(State(w), now))
            .OrderBy(w => State(w)!.DueAt);
        // Check-ins for words learned earlier today, also from every word.
        var checks = words!
            .Where(w => IsCheckIn(State(w)))
            .OrderBy(w => State(w)!.CheckIn);
        var due = groupWords
            .Where(w => Srs.IsDue(State(w), today))
            .OrderBy(w => State(w)!.Interval)
            .ThenBy(w => State(w)!.Due)
            .ThenBy(w => State(w)!.LastSeen ?? DateTime.MinValue)
            .ThenBy(w => w.Rank)
            .ToList();
        var must = due.Where(w => required.Contains(w.Es));
        var bonus = due.Where(w => !required.Contains(w.Es));
        var fresh = groupWords.Where(w => includeNew && Srs.IsNew(State(w))).OrderBy(w => w.Rank);
        var ahead = words!
            .Where(w => Srs.IsLearning(State(w)) && !Srs.IsStepDue(State(w), now)
                        && Srs.IsStepDue(State(w), now, Srs.LearnAheadMinutes))
            .OrderBy(w => State(w)!.DueAt);
        var all = steps.Concat(checks).Concat(must).Concat(fresh).Concat(bonus).Concat(ahead).ToList();
        return all.Where(w => !skipped.Contains(w.Es)).Concat(all.Where(w => skipped.Contains(w.Es))).ToList();
    }

    /// <summary>
    /// Extra practice: words in reviews that aren't due. Tricky words and the shortest gaps first,
    /// least recently seen first. Marked-as-known words never come back.
    /// </summary>
    private List<Word> ExtraQueue(List<Word> groupWords) =>
        groupWords
            .Where(w => State(w) is { Phase: CardPhase.Review, Retired: false } s && !Srs.IsDue(s, today))
            .OrderByDescending(w => Srs.IsTricky(State(w)))
            .ThenBy(w => State(w)!.Interval)
            .ThenBy(w => State(w)!.LastSeen ?? DateTime.MinValue)
            .ThenBy(w => w.Rank)
            .ToList();

    private int PracticeIndex(List<Word> queue) =>
        queue.Count == 0 ? 0 : ((practiceIdx % queue.Count) + queue.Count) % queue.Count;

    /// <summary>
    /// The card to show. Once a card is on screen it stays until you answer or skip it, even if a learning
    /// step becomes due meanwhile (so the card can't change under your finger).
    /// </summary>
    private Word? CurrentCard(List<Word> queue)
    {
        if (queue.Count == 0) { currentId = null; return null; }
        if (currentId is not null && queue.FirstOrDefault(w => w.Es == currentId) is { } stay) return stay;
        Word pick;
        if (onExtra) pick = queue[PracticeIndex(queue)];
        // Avoid showing the card you just answered twice in a row.
        else pick = queue.Count > 1 && queue[0].Es == lastAnswered ? queue[1] : queue[0];
        currentId = pick.Es;
        return pick;
    }

    /// <summary>
    /// All that's left are learning steps that aren't due yet: rather than asking them straight away, wait
    /// a moment for the soonest one (spacing them out is what makes them stick). Null otherwise.
    /// </summary>
    private Word? WaitingFor(List<Word> queue)
    {
        if (queue.Count == 0 || currentId is not null) return null;
        var now = DateTime.UtcNow;
        if (!queue.All(w => Srs.IsLearning(State(w)) && !Srs.IsStepDue(State(w), now))) return null;
        var soonest = queue.OrderBy(w => State(w)!.DueAt).First();
        return waitSkipped == soonest.Es ? null : soonest;
    }

    private static string WaitText(Word w, DateTime dueUtc)
    {
        var mins = (int)Math.Ceiling((dueUtc - DateTime.UtcNow).TotalMinutes);
        var when = mins <= 1 ? "in under a minute" : $"in about {mins} minutes";
        return $"{w.Es} comes back {when}. A short gap is what makes it stick.";
    }

    /// <summary>Re-draw when the waited-for step is due.</summary>
    private async Task WakeAt(DateTime dueUtc)
    {
        var delay = dueUtc - DateTime.UtcNow;
        if (delay > TimeSpan.Zero) await Task.Delay(delay + TimeSpan.FromMilliseconds(300));
        await InvokeAsync(StateHasChanged);
    }

    private DateOnly? NextDueIn(List<Word> groupWords)
    {
        var dates = groupWords.Select(State).Where(s => s is { Phase: CardPhase.Review, Retired: false }).Select(s => s!.Due).ToList();
        return dates.Count == 0 ? null : dates.Min();
    }

    /// <summary>A word learned earlier today whose check-in is due (and check-ins are on).</summary>
    private bool IsCheckIn(CardState? s) => progress.CheckIns && Srs.IsCheckInDue(s, DateTime.UtcNow, today);

    /// <summary>"Come back after 3:40 PM for a quick check of 6 words you learned today."</summary>
    private static string CheckInLaterText(List<DateTime> times)
    {
        var first = times.Min().ToLocalTime();
        var n = times.Count;
        var what = n == 1 ? "a word" : $"{n} words";
        return $"Come back after {first:h:mm tt} for a quick check of {what} you learned today.";
    }

    /// <summary>How many cards are already due on each day (used to spread out new review dates).</summary>
    private Dictionary<DateOnly, int> LoadByDay() =>
        progress.Cards.Values
            .Where(c => c.Phase == CardPhase.Review && !c.Retired)
            .GroupBy(c => c.Due)
            .ToDictionary(g => g.Key, g => g.Count());

    private string CardStatus(CardState? s, bool isRequired)
    {
        var tricky = Srs.IsTricky(s) ? " · tricky" : "";
        if (Srs.IsNew(s)) return "New word";
        if (s!.Phase == CardPhase.Learning) return $"Learning · step {Math.Max(1, s.Step)} of {Srs.LearningSteps}{tricky}";
        if (s.Phase == CardPhase.Relearning) return $"Relearning{tricky}";
        if (!onExtra && IsCheckIn(s)) return "Check-in · learned earlier today";
        var gap = $"last gap {Srs.GapText(s.Interval)}";
        if (Srs.IsDue(s, today)) return $"{(isRequired ? "Review" : "Bonus review")} · {gap}{tricky}";
        return $"Extra practice · {Srs.DueLabel(s, today)}{tricky}";
    }

    private string CardAria(Word w, CardMode mode, bool englishFirst)
    {
        if (mode == CardMode.Intro) return $"New word: {w.SpanishWithArticle}, {w.En}. Example: {w.Example}";
        if (flipped) return $"Answer: {w.SpanishWithArticle}, {w.En}.";
        if (mode is CardMode.PickEnglish or CardMode.PickSpanish)
            return englishFirst
                ? $"English: {w.En}. Choose the Spanish word below."
                : $"Spanish: {w.SpanishWithArticle}. Choose the meaning below.";
        return englishFirst
            ? $"English: {w.En}. Answer in Spanish, then tap to check."
            : $"Spanish: {w.SpanishWithArticle}. Answer in English, then tap to check.";
    }

    /// <summary>
    /// New → introduction. Learning step 1 → pick the English (recognise it); step 2 → pick the Spanish;
    /// step 3, relearning, reviews and extra practice → recall the Spanish yourself.
    /// </summary>
    private CardMode ModeFor(CardState? s)
    {
        if (onExtra) return CardMode.Recall;
        if (Srs.IsNew(s)) return CardMode.Intro;
        if (s!.Phase == CardPhase.Learning)
            return s.Step <= 1 ? CardMode.PickEnglish : s.Step == 2 ? CardMode.PickSpanish : CardMode.Recall;
        return CardMode.Recall; // reviews and relearning: recall the Spanish yourself
    }

    /// <summary>
    /// Which side a card shows first. Picking the English shows the Spanish; everything else shows the
    /// English and asks for the Spanish (the harder, more useful direction). Extra practice can show the
    /// Spanish first instead (Settings → Extra practice).
    /// </summary>
    private bool EnglishFirstFor(CardState? s)
    {
        if (onExtra) return progress.PracticeDirection != "es";
        return ModeFor(s) is CardMode.PickSpanish or CardMode.Recall;
    }

    private ChoiceKind ChoiceKindFor(CardState? s) => ModeFor(s) switch
    {
        CardMode.PickEnglish => ChoiceKind.English,
        CardMode.PickSpanish => ChoiceKind.Spanish,
        _ => ChoiceKind.None,
    };

    /// <summary>The conjugation box on the answer side of a verb card.</summary>
    private RenderFragment ConjugationBox(Word card) => b =>
    {
        if (card.Conjugation is null) return;
        var cj = card.ConjugationParts;
        b.OpenElement(0, "div");
        b.AddAttribute(1, "class", "conj");
        b.OpenElement(2, "div");
        b.OpenElement(3, "span");
        b.AddAttribute(4, "class", "conj-label");
        b.AddContent(5, "Present");
        b.CloseElement();
        b.AddContent(6, " " + cj.Present);
        b.CloseElement();
        if (cj.Past is not null)
        {
