    private string auddKeyInput = "";
    private string? auddKeyEnd;     // the last 4 characters of the saved key (null = none saved)
    private string? auddMessage;
    private string? scrollTo;       // an element to scroll to after the next render (Settings)

    private async Task LoadAuddKey()
    {
        var key = await Store.GetAuddKeyAsync();
        auddKeyEnd = string.IsNullOrWhiteSpace(key) ? null : key.Trim()[^Math.Min(4, key.Trim().Length)..];
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveAuddKey()
    {
        var key = auddKeyInput.Trim();
        if (key.Length == 0) return;
        if (await Store.SetAuddKeyAsync(key))
        {
            auddKeyInput = "";
            auddMessage = "Saved. Tap the microphone on the Read tab to try it.";
        }
        else auddMessage = "This browser wouldn't save the key (private browsing?).";
        await LoadAuddKey();
    }

    private async Task RemoveAuddKey()
    {
        await Store.SetAuddKeyAsync(null);
        auddMessage = "Key removed from this browser.";
        await LoadAuddKey();
    }

