    /// <summary>
    /// Saves one answer to the review history. The entry is made straight away (before the card changes), and
    /// saving runs in the background: it never fails, and the history isn't needed to study.
    /// </summary>
    /// <param name="rating">The rating applied; <paramref name="fsrsRating"/> instead for "I already know it" (4 = easy).</param>
    private Task Log(string word, string kind, CardState? before, CardState? after, Rating? rating = null,
                     int fsrsRating = 0, string? check = null)
    {
        var r = rating is { } x ? Srs.FsrsRating(x) : fsrsRating;
        var mem = after ?? before;
        var last = before?.RatedOn ?? before?.LastReview;
        var entry = new ReviewEntry
        {
            W = word,
            T = ReviewHistory.Now(),
            K = kind,
            R = r,
            // FSRS states: 0 = the word's first rated answer (no memory yet), else its phase before the answer.
            P = before is null || (!Srs.HasMemory(before) && before.Phase is CardPhase.New or CardPhase.Learning) ? 0 : (int)before.Phase,
            E = last is { } d && before!.Phase != CardPhase.New ? Math.Max(0, today.DayNumber - d.DayNumber) : -1,
            I = before is { Phase: CardPhase.Review, Retired: false } ? before.Interval : 0,
            N = mem is { Phase: CardPhase.Review or CardPhase.Relearning, Retired: false } ? mem.Interval : 0,
            S = Math.Round(mem?.Stability ?? 0, 4),
            D = Math.Round(mem?.Difficulty ?? 0, 4),
            Ms = r > 0 ? lastAnswerMs : 0,
            C = check,
        };
        history?.Add(entry);
        return Store.LogAsync(entry);
    }

