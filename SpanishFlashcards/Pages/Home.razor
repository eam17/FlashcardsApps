@code {
    private enum Tab { Study, Words, Read, Verbs, Games, Settings }
    private enum WordsFilter { ToLearn, Learned, All }
    private WordsFilter wordsFilter = WordsFilter.ToLearn;

    private string WordsHint => wordsFilter switch
    {
        WordsFilter.Learned => "Words land here after you answer them in Spanish on schedule up to level 4, or when you tap Mark learned (those never come back). Tap Relearn to practice a word again.",
        WordsFilter.ToLearn => "New words start with picking the English meaning. At level 2 they switch: you see the English and answer in Spanish. Tap Mark learned for a word you already know.",
        _ => "Every word in this group. Mark learned skips a word for good; Relearn brings it back.",
    };
    private enum ChoiceKind { None, English, Spanish }

    private sealed record GroupDef(string Id, string Label, string Section, Func<Word, bool> Includes);

    private IReadOnlyList<Word>? words;
    /// <summary>The 1,000-word list (words also has your own words from the Read tab).</summary>
    private IReadOnlyList<Word> baseWords = [];
    private Dictionary<string, Word> byId = new();
    private Progress progress = new();
    private List<GroupDef> groups = new();

    private DateOnly today = Srs.Today;
    private Tab tab = Tab.Study;
    private bool keepGoing;   // tapped Keep going: extra practice after today's cards
    private bool onExtra;     // the card on screen is extra practice (set while rendering)
    private string groupId = "freq:1";
    private bool flipped;
    private int practiceIdx;
    private string? lastAnswered;
    private readonly HashSet<string> skipped = new();
    private string? notice;
    private int noticeVersion;
    private bool confirmReset;
    private bool canSpeak;

    // Multiple choice for the card on screen
    private string? choiceKey;
    private List<Word> choices = new();
    private Word? picked;
    // After picking an option: what will happen to the card, shown before Continue and applied on Continue.
    private CardState? pendingNext;
    private bool pickedSlow;

    // Answer timer: a right answer slower than the limit in Settings keeps the word at its level (see Srs.Slow).
    private static readonly int[] TimerChoices = [2, 3, 4, 5, 6, 7, 8, 10, 12, 15];
    private string? shownCardKey;  // the card on screen (set while rendering)
    private string? timedCardKey;  // the card the timer was started for

    private string? transferMessage;
    private bool transferError;

    protected override async Task OnInitializedAsync()
    {
        baseWords = await Repo.GetAllAsync();
        progress = await Store.LoadAsync();
        RebuildWords();

        if (progress.Group is { } g && groups.Any(x => x.Id == g)) groupId = g;
        VerbSettings.Vosotros = progress.ShowVosotros;
    }

    /// <summary>The word list plus your own words (Read tab), and the groups (including one per text).</summary>
    private void RebuildWords()
    {
        var all = baseWords.Concat(progress.MyWords.Select((m, i) => m.ToWord(baseWords.Count + i + 1))).ToList();
        byId = new Dictionary<string, Word>();
        foreach (var w in all) byId.TryAdd(w.Es, w);
        all = all.Where(w => byId[w.Es] == w).ToList();
        groups = BuildGroups(all);

        // Saved progress for words that aren't in the current list is kept (never deleted),
        // so editing words.json can't wipe anything; it just isn't shown.
        if (progress.Order is null || progress.Order.Count != all.Count || progress.Order.Any(id => !byId.ContainsKey(id)))
            progress.Order = null;
        if (!groups.Any(x => x.Id == groupId)) groupId = "freq:1";
        words = all;
    }

    /// <summary>The Read tab changed your texts or words: save, and rebuild the words and groups.</summary>
    private async Task ReadChanged()
    {
        RebuildWords();
        await SaveProgress();
    }

    /// <summary>From the Read tab: study a text's words on the Cards tab.</summary>
    private async Task StudyGroup(string id)
    {
        RebuildWords();
        if (!groups.Any(x => x.Id == id)) return;
        groupId = id;
        SetTab(Tab.Study);
        await OnGroupChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A new card is on screen: start its answer timer.
        if (tab == Tab.Study && shownCardKey is not null && shownCardKey != timedCardKey)
        {
            timedCardKey = shownCardKey;
            try { await JS.InvokeVoidAsync("palabras.timerStart"); }
            catch (Exception) { }
        }
        if (!firstRender) return;
        // Ask the browser to keep this site's storage even when the phone is low on space.
        try { await JS.InvokeAsync<bool>("palabras.persistStorage"); }
        catch (Exception) { }
        try { canSpeak = await JS.InvokeAsync<bool>("palabras.canSpeak"); }
        catch (Exception) { canSpeak = false; }
        if (canSpeak) StateHasChanged();
    }

    private List<GroupDef> BuildGroups(IReadOnlyList<Word> all)
    {
        var list = new List<GroupDef>
        {
            new("all", $"All {all.Count:N0} words", "", _ => true),
            new("tricky", "Tricky words (forgotten often)", "", w => Srs.IsTricky(State(w))),
        };
        for (var start = 1; start <= baseWords.Count; start += 100)
        {
            var band = Word.BandFor(start);
            list.Add(new($"freq:{start}", $"Words {band}", "By frequency", w => w.Band == band));
        }
        foreach (var topic in all.Select(w => w.Topic).Distinct().OrderBy(t => t, StringComparer.CurrentCulture))
        {
            var count = all.Count(w => w.Topic == topic);
            list.Add(new($"topic:{topic}", $"{topic} ({count})", "By topic", w => w.Topic == topic));
        }
        foreach (var text in progress.Texts.Where(t => t.Study.Count > 0).OrderByDescending(t => t.Added))
        {
            var t = text;
            list.Add(new($"text:{t.Id}", $"{t.Title} ({t.Study.Count})", "From your texts", w => t.Study.Contains(w.Es)));
        }
        return list;
    }

    // ----- derived state -----

    private GroupDef CurrentGroup => groups.FirstOrDefault(g => g.Id == groupId) ?? groups[0];

    private int GroupIndex => groups.FindIndex(g => g.Id == groupId);

    private CardState? State(Word w) => progress.Cards.TryGetValue(w.Es, out var s) ? s : null;

    private int LearnedCount => words is null ? 0 : words.Count(w => Srs.IsLearned(State(w)));

    private int Percent => words is { Count: > 0 } ? (int)Math.Round(LearnedCount * 100.0 / words.Count) : 0;

    private string Kicker => tab switch
    {
        Tab.Study => "Palabras",
        Tab.Games => "Play",
        _ => "Your words",
    };

    private string ScreenTitle => tab switch
    {
        Tab.Study => "Learn",
        Tab.Games => "Games",
        Tab.Read => "Read",
        Tab.Verbs => "Verbs",
        Tab.Settings => "Settings",
        _ => "Words",
    };

    /// <summary>Start a fresh daily review counter when the day changes.</summary>
    private void EnsureReviewDay()
    {
        today = Srs.Today;
        if (progress.ReviewDay != today)
        {
            progress.ReviewDay = today;
            progress.ReviewsDoneToday = 0;
        }
    }

    /// <summary>
    /// The due reviews you HAVE to do today, across all words: up to the daily limit minus what
    /// you've already done. Lower levels and the most overdue words go first; the rest wait as
    /// optional extras and roll forward to later days.
    /// </summary>
    private HashSet<string> RequiredReviewIds()
    {
        var limit = progress.DailyReviewLimit;
        var left = limit <= 0 ? int.MaxValue : Math.Max(0, limit - progress.ReviewsDoneToday);
        if (left == 0 || words is null) return new HashSet<string>();
        return words
            .Where(w => Srs.IsDue(State(w), today))
            .OrderBy(w => State(w)!.Box)
            .ThenBy(w => State(w)!.Due)
            .ThenBy(w => w.Rank)
            .Take(left)
            .Select(w => w.Es)
            .ToHashSet();
    }

    /// <summary>Required reviews first, then new words, then optional extra reviews. Skipped cards go last.</summary>
    private List<Word> ReviewQueue(List<Word> groupWords, HashSet<string> required)
    {
        var due = groupWords
            .Where(w => Srs.IsDue(State(w), today))
            .OrderBy(w => State(w)!.Box)
            .ThenBy(w => State(w)!.Due)
            .ThenBy(w => State(w)!.LastSeen ?? DateTime.MinValue)
            .ThenBy(w => w.Rank)
            .ToList();
        var must = due.Where(w => required.Contains(w.Es));
        var extra = due.Where(w => !required.Contains(w.Es));
        var fresh = groupWords.Where(w => Srs.IsNew(State(w))).OrderBy(w => w.Rank);
        var all = must.Concat(fresh).Concat(extra).ToList();
        return all.Where(w => !skipped.Contains(w.Es)).Concat(all.Where(w => skipped.Contains(w.Es))).ToList();
    }

    /// <summary>
    /// Extra practice: words you've seen that aren't due. Tricky and low-level words first,
    /// least recently seen first. Marked-as-known words never come back.
    /// </summary>
    private List<Word> ExtraQueue(List<Word> groupWords) =>
        groupWords
            .Where(w => State(w) is { } s && s.Box > 0 && !s.Retired && !Srs.IsDue(s, today))
            .OrderByDescending(w => Srs.IsTricky(State(w)))
            .ThenBy(w => State(w)!.Box)
            .ThenBy(w => State(w)!.LastSeen ?? DateTime.MinValue)
            .ThenBy(w => w.Rank)
            .ToList();

    private int PracticeIndex(List<Word> queue) =>
        queue.Count == 0 ? 0 : ((practiceIdx % queue.Count) + queue.Count) % queue.Count;

    private Word? CurrentCard(List<Word> queue)
    {
        if (queue.Count == 0) return null;
        if (onExtra) return queue[PracticeIndex(queue)];
        // Avoid showing the card you just answered twice in a row.
        return queue.Count > 1 && queue[0].Es == lastAnswered ? queue[1] : queue[0];
    }

    private DateOnly? NextDueIn(List<Word> groupWords)
    {
        var dates = groupWords.Select(State).Where(s => s is { Box: > 0, Retired: false }).Select(s => s!.Due).ToList();
        return dates.Count == 0 ? null : dates.Min();
    }

    /// <summary>How many cards are already due on each day (used to spread out new review dates).</summary>
    private Dictionary<DateOnly, int> LoadByDay() =>
        progress.Cards.Values
            .Where(c => c.Box > 0 && !c.Retired)
            .GroupBy(c => c.Due)
            .ToDictionary(g => g.Key, g => g.Count());

    private string CardStatus(CardState? s, bool isRequired)
    {
        if (Srs.IsNew(s)) return "New word";
        var tricky = Srs.IsTricky(s) ? " · tricky" : "";
        if (Srs.IsDue(s, today)) return $"{Srs.StageLabel(s)} · {(isRequired ? "due now" : "bonus review")}{tricky}";
        return $"{Srs.StageLabel(s)} · extra practice ({Srs.DueLabel(s, today)}){tricky}";
    }

    private string CardAria(Word w, bool choiceMode)
    {
        if (flipped) return $"Answer: {w.SpanishWithArticle}, {w.En}.";
        var english = EnglishFirstFor(State(w));
        if (choiceMode)
            return english
                ? $"English: {w.En}. Choose the Spanish word below."
                : $"Spanish: {w.SpanishWithArticle}. Choose the meaning below.";
        return english
            ? $"English: {w.En}. Answer in Spanish, then tap to check."
            : $"Spanish: {w.SpanishWithArticle}. Answer in English, then tap to check.";
    }

    /// <summary>
    /// Which side a card shows first. Normally it follows the card's level: new and level-1 cards
    /// show Spanish (answer in English); from level 2 they show English (answer in Spanish).
    /// Extra practice can override this (Settings → Extra practice).
    /// </summary>
    private bool EnglishFirstFor(CardState? s)
    {
        if (onExtra && progress.PracticeDirection == "en") return true;
        if (onExtra && progress.PracticeDirection == "es") return false;
        return Srs.AsksForSpanish(s);
    }

    /// <summary>
    /// Multiple choice on the early levels: new / level 1 (Spanish shown) → pick the English meaning;
    /// level 2 (English + blanked sentence shown) → pick the Spanish word. From level 3 you recall it yourself.
    /// </summary>
    private static ChoiceKind ChoiceKindFor(CardState? s, bool englishFirst)
    {
        var level = s?.Box ?? 0;
        if (!englishFirst && level <= 1) return ChoiceKind.English;
        if (englishFirst && level == Srs.RecallLevel) return ChoiceKind.Spanish;
        return ChoiceKind.None;
    }

    /// <summary>Builds the 6 options once per card (so they don't reshuffle while you look at them).</summary>
    private void EnsureChoices(Word card, ChoiceKind kind, CardState? s)
    {
        var key = $"{card.Es}|{kind}|{s?.Box ?? 0}|{s?.LastSeen?.Ticks ?? 0}";
        if (key == choiceKey) return;
        choiceKey = key;
        picked = null;
        choices = MakeChoices(card, kind);
    }

    /// <summary>
    /// The right answer plus 5 believable wrong ones: same part of speech (and same topic when possible).
    /// For Spanish nouns, prefer the same article so "la ____" doesn't give the answer away.
    /// Meanings that overlap with the right answer ("time" vs "time; weather") are skipped.
    /// </summary>
    private List<Word> MakeChoices(Word card, ChoiceKind kind)
    {
        var meaning = MeaningParts(card.En);
        var pool = words!
            .Where(w => w.Es != card.Es && w.En != card.En && !MeaningParts(w.En).Overlaps(meaning))
            .OrderBy(_ => Random.Shared.Next())
            .ToList();

        bool SamePos(Word w) => w.Pos == card.Pos;
        bool SameTopic(Word w) => w.Topic == card.Topic;
        bool SameArticle(Word w) => kind != ChoiceKind.Spanish || !card.IsNoun || w.Article == card.Article;

        var tiers = new[]
        {
            pool.Where(w => SamePos(w) && SameArticle(w) && SameTopic(w)),
            pool.Where(w => SamePos(w) && SameArticle(w)),
            pool.Where(SamePos),
            pool,
        };

        var picks = new List<Word>();
        foreach (var tier in tiers)
        {
            foreach (var w in tier)
            {
                if (picks.Count == 5) break;
                if (picks.Contains(w) || picks.Any(p => p.En == w.En || p.Es == w.Es)) continue;
                picks.Add(w);
            }
            if (picks.Count == 5) break;
        }

        picks.Add(card);
        return picks.OrderBy(_ => Random.Shared.Next()).ToList();
    }

    private static HashSet<string> MeaningParts(string en) =>
        en.Split(new[] { ',', ';', '/', '(', ')' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
          .Select(p => p.ToLowerInvariant())
          .Select(p => p.StartsWith("to ") ? p[3..].Trim() : p)
          .Where(p => p.Length > 0)
          .ToHashSet();

    private static string BadgeClass(CardState? s) =>
        Srs.IsLearned(s) ? "known" : Srs.IsNew(s) ? "new" : "learning";

    private static string SpeakableWord(Word w) =>
        w.IsNoun ? $"{(w.Article == "el / la" ? "el" : w.Article)} {w.Es}" : w.Es.Replace(" / ", ", ");

    // ----- actions -----

    private Task SaveProgress() => Store.SaveAsync(progress);

    private Task VosotrosChanged()
    {
        VerbSettings.Vosotros = progress.ShowVosotros;
        return SaveProgress();
    }

    private void Flip() => flipped = !flipped;

    private void ResetCardView()
    {
        flipped = false;
        picked = null;
        pendingNext = null;
        pickedSlow = false;
        choiceKey = null;
    }

    private void SetTab(Tab t)
    {
        timedCardKey = null; // coming back to Cards restarts the timer
        tab = t;
        confirmReset = false;
        flipped = false;
    }

    private void KeepGoing()
    {
        keepGoing = true;
        practiceIdx = 0;
        ResetCardView();
        notice = null;
    }

    private async Task OnGroupChanged()
    {
        practiceIdx = 0;
        keepGoing = false;
        ResetCardView();
        notice = null;
        skipped.Clear();
        progress.Group = groupId;
        await Store.SaveAsync(progress);
    }

    private async Task StepGroup(int step)
    {
        var i = Math.Clamp(GroupIndex + step, 0, groups.Count - 1);
        groupId = groups[i].Id;
        await OnGroupChanged();
    }

    private void Skip(Word card)
    {
        if (onExtra) practiceIdx++;
        else skipped.Add(card.Es);
        lastAnswered = card.Es;
        ResetCardView();
        notice = null;
    }

    private async Task Choose(Word option, Word card, ChoiceKind kind)
    {
        var slow = await IsSlow(kind == ChoiceKind.Spanish);
        picked = option;
        flipped = true; // show the full answer side
        today = Srs.Today;
        pickedSlow = option == card && slow && Srs.Counts(State(card), today);
        // Work out the result now; Continue saves it.
        pendingNext = option != card ? Srs.Forgot(State(card), today)
            : pickedSlow ? Srs.Slow(State(card), today)
            : Srs.Know(State(card), today, LoadByDay());
    }

    private async Task ContinueAfterChoice(Word card)
    {
        var before = State(card);
        CountReview(before);
        if (pendingNext is not null) progress.Cards[card.Es] = pendingNext;
        notice = null;
        AfterAnswer(card);
        await Store.SaveAsync(progress);
    }

    /// <summary>Counts a review toward today's required reviews when the card was due.</summary>
    private void CountReview(CardState? before)
    {
        if (!Srs.IsDue(before, today)) return;
        EnsureReviewDay();
        progress.ReviewsDoneToday++;
    }

    /// <summary>
    /// True when the answer took longer than the limit (set in Settings: 4 s for English answers and 6 s for Spanish by default).
    /// Time while the app is in the background doesn't count.
    /// </summary>
    private async Task<bool> IsSlow(bool answerInSpanish)
    {
        try
        {
            var limit = answerInSpanish ? progress.SpanishAnswerSeconds : progress.EnglishAnswerSeconds;
            if (limit <= 0) return false; // timer off
            var ms = await JS.InvokeAsync<double>("palabras.timerElapsed");
            return ms > limit * 1000;
        }
        catch (Exception) { return false; } // no timer: never punish
    }

    private async Task AnswerKnow(Word card)
    {
        var slow = await IsSlow(EnglishFirstFor(State(card)));
        today = Srs.Today;
        var before = State(card);
        var counts = Srs.Counts(before, today);
        var next = slow && counts ? Srs.Slow(before, today) : Srs.Know(before, today, LoadByDay());
        CountReview(before);
        if (next is not null) progress.Cards[card.Es] = next;
        notice = slow && counts ? "slow" : null; // just a small clock icon, no text
        AfterAnswer(card);
        await Store.SaveAsync(progress);
    }

    private async Task AnswerForgot(Word card)
    {
        today = Srs.Today;
        var before = State(card);
        CountReview(before);
        progress.Cards[card.Es] = Srs.Forgot(before, today);
        notice = null;
        AfterAnswer(card);
        await Store.SaveAsync(progress);
    }

    /// <summary>Hide the feedback message after a couple of seconds so it doesn't cover the next card.</summary>
    private void HideNoticeSoon()
    {
        var v = ++noticeVersion;
        _ = HideNoticeLater(v);
    }

    private async Task HideNoticeLater(int version)
    {
        await Task.Delay(2600);
        if (version != noticeVersion) return;
        notice = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ResetTapped()
    {
        if (!confirmReset)
        {
            confirmReset = true;
            return;
        }
        confirmReset = false;
        await Reset();
    }

    private void AfterAnswer(Word card)
    {
        if (notice is not null) HideNoticeSoon();
        lastAnswered = card.Es;
        skipped.Remove(card.Es);
        ResetCardView();
        // A word you got wrong leaves extra practice (it's due again), so the next word slides into its spot.
        if (onExtra && !Srs.IsDue(State(card), today)) practiceIdx++;
    }

    private async Task Move(Word w, bool fromLearned)
    {
        today = Srs.Today;
        // Relearn on a word you only marked as known (never learned it here): back to New, not counted as
        // forgetting it. A word learned through reviews goes back to practice (Srs.Forgot).
        if (fromLearned && Srs.IsRetired(State(w))) progress.Cards.Remove(w.Es);
        else progress.Cards[w.Es] = fromLearned ? Srs.Forgot(State(w), today) : Srs.MarkLearned(today);
        await Store.SaveAsync(progress);
    }

    private async Task Speak(string text)
    {
        try { await JS.InvokeAsync<bool>("palabras.speak", text, false); }
        catch (Exception) { /* speech not available */ }
    }

    // ----- export / import -----

    private async Task ExportJson()
    {
        var json = ProgressTransfer.ToJson(words!, progress.Cards, progress.VerbSkills, progress.VerbTests, progress.Texts, progress.MyWords);
        await JS.InvokeVoidAsync("palabras.downloadText", $"palabras-progress-{DateTime.Now:yyyy-MM-dd}.json", "application/json", json);
        var verbForms = progress.VerbSkills.Values.Count(VerbSrs.IsSeen);
        ShowTransfer($"Exported {LearnedCount} learned and {words!.Count - LearnedCount} not-yet-learned words, and {verbForms} practised verb forms.");
    }

    private async Task ExportCsv()
    {
        var csv = ProgressTransfer.ToCsv(words!, progress.Cards);
        await JS.InvokeVoidAsync("palabras.downloadText", $"palabras-progress-{DateTime.Now:yyyy-MM-dd}.csv", "text/csv;charset=utf-8", csv);
        ShowTransfer($"Exported {LearnedCount} learned and {words!.Count - LearnedCount} not-yet-learned words.");
    }

    private async Task ImportFile(InputFileChangeEventArgs e)
    {
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 2_000_000);
            using var reader = new StreamReader(stream);
            var text = await reader.ReadToEndAsync();

            // Texts and your own words first, so the progress on your own words can be matched.
            var (texts, myWords) = ProgressTransfer.ReadReading(text, e.File.Name);
            if (texts is not null) progress.Texts = texts;
            if (myWords is not null) progress.MyWords = myWords;
            RebuildWords();

            var result = ProgressTransfer.Import(text, e.File.Name, words!);
            progress.Cards = result.Cards;
            // Older exports and CSV files have no verb progress: keep what's on this device.
            if (result.VerbSkills is not null)
            {
                progress.VerbSkills = result.VerbSkills;
                progress.VerbTests = result.VerbTests ?? new();
            }
            practiceIdx = 0;
            ResetCardView();
            skipped.Clear();
            await Store.SaveAsync(progress);

            var msg = $"Imported {result.Learned} learned and {result.Learning} still-learning words from {e.File.Name}.";
            if (result.Unknown > 0) msg += $" {result.Unknown} words weren't in the app's list and were skipped.";
            msg += result.VerbSkills is null
                ? " The file has no verb progress, so your verb progress on this device was kept."
                : $" Verb progress: {result.VerbSkills.Count} practised forms.";
            ShowTransfer(msg);
        }
        catch (Exception ex)
        {
            ShowTransfer($"Couldn't import {e.File.Name}: {ex.Message}", error: true);
        }
    }

    private void ShowTransfer(string message, bool error = false)
    {
        transferMessage = message;
        transferError = error;
    }

    private async Task Reset()
    {
        progress.Cards = new();
        progress.VerbSkills = new();
        progress.VerbRotation = new();
        progress.VerbTests = new();
        progress.Order = null;
        progress.ReviewsDoneToday = 0;
        practiceIdx = 0;
        keepGoing = false;
        ResetCardView();
        skipped.Clear();
        notice = null;
        await Store.SaveAsync(progress);
    }
}
