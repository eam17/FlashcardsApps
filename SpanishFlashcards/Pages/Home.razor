    /// <summary>A learning step (multiple choice): work out the result now; Continue saves it.</summary>
    private async Task Choose(Word option, Word card, ChoiceKind kind)
    {
        var slow = await IsSlow(kind == ChoiceKind.Spanish);
        picked = option;
        flipped = true; // show the full answer side
        today = Srs.Today;
        var before = State(card);
        var right = option.Es == card.Es;
        pickedSlow = right && slow;
        pendingRating = Srs.StepRating(right, slow);
        pendingNext = before is null ? null : Srs.Step(before, pendingRating.Value, DateTime.UtcNow, today, LoadByDay());
    }

    private async Task ContinueAfterChoice(Word card)
    {
        if (pendingNext is not null)
        {
            var before = State(card);
            var kind = before is { Step: >= 2 } ? ReviewKind.PickSpanish : ReviewKind.PickEnglish;
            _ = Log(card.Es, kind, before, pendingNext, pendingRating ?? Rating.Good);
            progress.Cards[card.Es] = pendingNext;
        }
        notice = null;
        AfterAnswer(card);
        await Store.SaveAsync(progress);
    }

    /// <summary>"Got it" on a new word: it's introduced, and the first step comes up a minute later.</summary>
    private async Task MeetWord(Word card)
    {
        EnsureReviewDay();
        progress.NewDoneToday++;
        var met = Srs.Introduce(DateTime.UtcNow);
        _ = Log(card.Es, ReviewKind.Intro, State(card), met);
        progress.Cards[card.Es] = met;
        notice = null;
        AfterAnswer(card);
        await Store.SaveAsync(progress);
    }

    /// <summary>"I already know it" on a new word: no steps, a first review in a few days (doesn't count as a new word).</summary>
    private async Task AlreadyKnowIt(Word card)
    {
        today = Srs.Today;
        var next = Srs.AlreadyKnown(today, LoadByDay());
        lastAnswerMs = 0; // not timed
        _ = Log(card.Es, ReviewKind.Known, State(card), next, fsrsRating: 4);
        progress.Cards[card.Es] = next;
        ShowNotice($"First review in {Srs.GapText(next.Due.DayNumber - today.DayNumber)}");
        AfterAnswer(card);
        await Store.SaveAsync(progress);
    }

    /// <summary>
    /// What a recall answer does to a word. Learning and relearning steps: Got it moves on, Hard or Forgot
    /// repeats the step a minute later. Reviews: Forgot / Hard / Got it, and a slow Got it counts as Hard.
    /// </summary>
    private CardState? NextAfterRecall(CardState before, Rating rating, bool slow, out bool slowHard) =>
        NextAfterRecall(before, rating, slow, out slowHard, out _);

    /// <param name="used">The rating that was applied (a slow Got it counts as Hard).</param>
    private CardState? NextAfterRecall(CardState before, Rating rating, bool slow, out bool slowHard, out Rating used)
    {
        var now = DateTime.UtcNow;
        var slowGood = rating == Rating.Good && slow;
        if (Srs.IsLearning(before))
        {
            // A slow right answer repeats the step (the message says "again in a minute").
            slowHard = false;
            used = slowGood ? Rating.Hard : rating;
            return Srs.Step(before, used, now, today, LoadByDay());
        }
        if (!onExtra && IsCheckIn(before))
        {
            // The check-in asks whether it stuck: Hard (a slip, or slow) still counts as remembered.
            slowHard = slowGood;
            used = slowGood ? Rating.Hard : rating;
            return Srs.CheckInAnswer(before, used, now, today);
        }
        slowHard = slowGood && Srs.IsDue(before, today);
        used = slowHard ? Rating.Hard : rating;
        return Srs.Review(before, used, now, today, LoadByDay());
    }

    /// <summary>Applies a recall answer (graded by you, or checked when you type), then moves to the next card.</summary>
    private async Task ApplyRecall(Word card, Rating rating, bool slow, string? check = null)
    {
        today = Srs.Today;
        var before = State(card);
        if (before is null) return;
        var kind = onExtra ? ReviewKind.Extra
            : IsCheckIn(before) ? ReviewKind.CheckIn
            : before.Phase == CardPhase.Learning ? ReviewKind.Recall
            : before.Phase == CardPhase.Relearning ? ReviewKind.Relearn
            : Srs.IsDue(before, today) ? ReviewKind.Review
            : ReviewKind.Extra;
        var next = NextAfterRecall(before, rating, slow, out var slowHard, out var used);
        _ = Log(card.Es, kind, before, next, used, check: check);
        if (!Srs.IsLearning(before)) CountReview(before);
        if (next is not null) progress.Cards[card.Es] = next;
        notice = null;
        var text = OutcomeText(before, next, slowHard);
        if (next is not null && text.Length > 0) ShowNotice(text, slowHard);
        AfterAnswer(card);
        await Store.SaveAsync(progress);
    }

    /// <summary>"Next review in 8 days", "Again in a minute"… (empty when nothing changes).</summary>
    private string OutcomeText(CardState before, CardState? next, bool slowHard)
    {
        if (next is null) return "";
        if (next.Phase == CardPhase.Relearning) return "It comes back in a few minutes to recall again";
        if (next.Phase == CardPhase.Learning) return "Again in a minute";
        var days = next.Due.DayNumber - today.DayNumber;
        if (before.Phase == CardPhase.Learning)
            return next.CheckIn is not null && progress.CheckIns
                ? "Learned! Quick check-in later today, first review tomorrow"
                : "Learned for today: first review tomorrow";
        if (!onExtra && IsCheckIn(before) && next.Phase == CardPhase.Review)
            return "Still there! First review tomorrow";
        return $"Next review in {Srs.GapText(days)}";
    }

    // ----- typing the Spanish -----

    private static readonly string[] AccentKeys = ["á", "é", "í", "ó", "ú", "ñ", "ü"];

    private string typedText = "";
    private WordCheckResult? typedResult;
    private bool typedOverride;   // "Count it as right"
    private bool typedSlow;
    private string? focusFor;     // the card whose answer box was focused

    private async Task TypedKey(KeyboardEventArgs e, Word card)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(typedText)) await CheckTyped(card);
    }

    private async Task AddLetter(string c)
    {
        typedText += c;
        try { await JS.InvokeVoidAsync("palabras.focusById", "word-answer"); }
        catch (Exception) { }
    }

    private async Task CheckTyped(Word card)
    {
        if (flipped) return;
        typedSlow = await IsSlow(true, factor: 2); // typing takes longer than saying it
        typedResult = WordCheck.Check(typedText, card, listSpellings);
        typedOverride = false;
        flipped = true;
        focusFor = "continue";
    }

    private async Task DontKnow(Word card)
    {
        await IsSlow(true); // only to note the time taken
        typedText = "";
        typedResult = WordCheckResult.Wrong;
        typedOverride = false;
        flipped = true;
        focusFor = "continue";
    }

    /// <summary>
    /// Right, or right but for a missing accent → Got it (slow → Hard); the wrong article or a one-letter slip →
    /// Hard; wrong → Forgot. A missing accent doesn't hold the word back: you remembered it, and the message
    /// shows the right spelling.
    /// </summary>
    private Rating TypedRating() => typedOverride ? Rating.Good : typedResult switch
    {
        WordCheckResult.Right or WordCheckResult.Accent => Rating.Good,
        WordCheckResult.Article or WordCheckResult.Almost => Rating.Hard,
        _ => Rating.Forgot,
    };

    private Task ContinueTyped(Word card) =>
        ApplyRecall(card, TypedRating(), typedSlow && !typedOverride,
                    typedOverride ? "override" : typedResult?.ToString().ToLowerInvariant());

    private string TypedMessage(Word card)
    {
        var answer = card.SpanishWithArticle;
        var you = typedText.Trim();
        if (typedOverride) return $"Counted as right: {answer}";
        return typedResult switch
        {
            WordCheckResult.Right => $"Right! {answer}",
            WordCheckResult.Accent => $"Almost: watch the accent. It's {answer} (you wrote {you})",
            WordCheckResult.Article => $"Right word, wrong article: it's {answer}",
            WordCheckResult.Almost => $"Almost: it's {answer} (you wrote {you})",
            _ => you.Length == 0 ? $"It's {answer}" : $"Not quite: it's {answer} (you wrote {you})",
        };
    }

    /// <summary>Under Continue: what will happen to the word.</summary>
    private string TypedOutcome(CardState? s)
    {
        if (s is null) return "";
        var next = NextAfterRecall(s, TypedRating(), typedSlow && !typedOverride, out var slowHard);
        if (next is null) return "Extra practice: nothing changes.";
        var text = OutcomeText(s, next, slowHard);
        return slowHard ? $"Right, but slow, so it counts as Hard. {text}." : $"{text}.";
    }

    private void ShowNotice(string text, bool slow = false)
    {
        notice = slow ? $"A bit slow, counted as Hard · {text.ToLowerInvariant()}" : text;
        noticeSlow = slow;
    }

    /// <summary>Counts a due review toward today's required reviews, once per word per day.</summary>
    private void CountReview(CardState? before)
    {
        if (!Srs.IsDue(before, today) || Srs.ReviewedToday(before, today)) return;
        EnsureReviewDay();
        progress.ReviewsDoneToday++;
    }

    /// <summary>
    /// True when the answer took longer than the limit (set in Settings: 4 s for English answers and 6 s for Spanish by default).
    /// Time while the app is in the background doesn't count.
    /// </summary>
    private async Task<bool> IsSlow(bool answerInSpanish, double factor = 1)
    {
        try
        {
            var ms = await JS.InvokeAsync<double>("palabras.timerElapsed");
            lastAnswerMs = (int)Math.Min(ms, int.MaxValue);
            var limit = (answerInSpanish ? progress.SpanishAnswerSeconds : progress.EnglishAnswerSeconds) * factor;
            if (limit <= 0) return false; // timer off
            return ms > limit * 1000;
        }
        catch (Exception) { lastAnswerMs = 0; return false; } // no timer: never punish
    }

    /// <summary>Hide the feedback message after a couple of seconds so it doesn't cover the next card.</summary>
    private void HideNoticeSoon()
    {
        var v = ++noticeVersion;
        _ = HideNoticeLater(v);
    }

    private async Task HideNoticeLater(int version)
    {
        await Task.Delay(2600);
        if (version != noticeVersion) return;
        notice = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ResetTapped()
    {
        if (!confirmReset)
        {
            confirmReset = true;
            return;
        }
        confirmReset = false;
        await Reset();
    }

    private void AfterAnswer(Word card)
    {
        if (notice is not null) HideNoticeSoon();
        lastAnswered = card.Es;
        currentId = null;
        waitSkipped = null;
        answerCount++;
        skipped.Remove(card.Es);
        ResetCardView();
        // A word you forgot leaves extra practice (it's relearning now), so the next word slides into its spot.
        if (onExtra && State(card) is { Phase: CardPhase.Review }) practiceIdx++;
    }

    private async Task Move(Word w, bool fromLearned)
    {
        today = Srs.Today;
        // Relearn on a word you only marked as known (never learned it here): back to New. A word learned
        // through reviews goes back to the first learning step. Neither counts as forgetting it.
        var before = State(w);
        if (fromLearned && Srs.IsRetired(before)) progress.Cards.Remove(w.Es);
        else progress.Cards[w.Es] = fromLearned ? Srs.Relearn(before, DateTime.UtcNow) : Srs.MarkLearned(today);
        _ = Log(w.Es, fromLearned ? ReviewKind.BackToLearn : ReviewKind.MarkLearned, before, State(w));
        await Store.SaveAsync(progress);
    }

    private async Task Speak(string text)
    {
        try { await JS.InvokeAsync<bool>("palabras.speak", text, false); }
        catch (Exception) { /* speech not available */ }
    }

